page {
  --fs-xs: 32rpx;
  --fs-sm: 34rpx;
  --fs-md: 36rpx;
  --fs-lg: 40rpx;
  --fs-xl: 44rpx;
  --fs-hero: 48rpx;
  --tap-sm: 96rpx;
  --tap-md: 104rpx;
  --tap-lg: 112rpx;
  --chip-min: 80rpx;
  min-height: 100%;
  background: #F3F4F1;
  color: #134E4A;
  font-size: var(--fs-md);
  box-sizing: border-box;
}

.page.ui-std {
  --fs-xs: 28rpx;
  --fs-sm: 30rpx;
  --fs-md: 32rpx;
  --fs-lg: 36rpx;
  --fs-xl: 40rpx;
  --fs-hero: 44rpx;
  --tap-sm: 88rpx;
  --tap-md: 96rpx;
  --tap-lg: 104rpx;
  --chip-min: 72rpx;
}

.page.ui-xl {
  --fs-xs: 36rpx;
  --fs-sm: 38rpx;
  --fs-md: 40rpx;
  --fs-lg: 44rpx;
  --fs-xl: 48rpx;
  --fs-hero: 52rpx;
  --tap-sm: 104rpx;
  --tap-md: 112rpx;
  --tap-lg: 120rpx;
  --chip-min: 88rpx;
}

button {
  padding: 0;
}

button::after {
  border: none;
}

.page {
  padding: 24rpx 24rpx 48rpx;
  font-size: var(--fs-md);
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 118, 110, 0.04);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 8rpx 16rpx;
  font-size: var(--fs-lg);
  font-weight: 600;
}

.muted {
  color: #64748B;
  font-size: var(--fs-sm);
}

.row {
  display: flex;
  align-items: center;
}

.space {
  justify-content: space-between;
}

.btn-primary {
  height: var(--tap-lg);
  line-height: var(--tap-lg);
  background: #0F766E;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: var(--fs-lg);
  font-weight: 600;
}

.btn-primary[disabled] {
  background: #99B8B4;
  color: #FFFFFF;
}

.btn-ghost {
  height: var(--tap-sm);
  line-height: var(--tap-sm);
  background: #E6F4F1;
  color: #0F766E;
  border-radius: 14rpx;
  font-size: var(--fs-md);
}

.btn-danger {
  height: var(--tap-md);
  line-height: var(--tap-md);
  background: #FEF2F2;
  color: #DC2626;
  border-radius: 14rpx;
  font-size: var(--fs-md);
}

.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: var(--fs-xs);
}

.tag-alert {
  background: #FEF2F2;
  color: #DC2626;
}

.tag-ok {
  background: #ECFDF5;
  color: #047857;
}

.tag-in {
  background: #ECFEFF;
  color: #0E7490;
}

.tag-out {
  background: #FFF7ED;
  color: #C2410C;
}

.tag-pay {
  background: #F5F3FF;
  color: #6D28D9;
}

.tag-credit {
  background: #FEF2F2;
  color: #DC2626;
}

.tag-spec {
  background: #ECFEFF;
  color: #0E7490;
}

.tag-blank {
  background: #EEF2FF;
  color: #4338CA;
}

.tag-return {
  background: #FFF7ED;
  color: #C2410C;
}

.tag-convert {
  background: #F5F3FF;
  color: #6D28D9;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.chip {
  display: flex;
  align-items: center;
  min-height: var(--chip-min);
  padding: 12rpx 28rpx;
  box-sizing: border-box;
  background: #F8FAF9;
  border-radius: 999rpx;
  color: #64748B;
  font-size: var(--fs-sm);
}

.chip.on {
  background: #0F766E;
  color: #FFFFFF;
  font-weight: 600;
}

.chip.low {
  background: #FEF2F2;
  color: #DC2626;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  color: #64748B;
  font-size: var(--fs-sm);
  margin-bottom: 12rpx;
}

.field-input {
  height: var(--tap-md);
  padding: 0 24rpx;
  background: #F8FAF9;
  border-radius: 14rpx;
  font-size: var(--fs-md);
}

.field-textarea {
  min-height: 160rpx;
  height: auto;
  padding: 20rpx 24rpx;
  line-height: 1.5;
  width: 100%;
  box-sizing: border-box;
}

.search {
  height: var(--tap-md);
  padding: 0 28rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  margin-bottom: 20rpx;
  font-size: var(--fs-md);
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #64748B;
}

.empty-title {
  font-size: var(--fs-lg);
  color: #134E4A;
  margin-bottom: 12rpx;
}
