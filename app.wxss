page {
  /* 旧 token 名，别名过渡（docs/ui-scale.md），新代码不要再用 */
  --fs-xs: var(--fs-caption);
  --fs-sm: var(--fs-label);
  --fs-md: var(--fs-body);
  --fs-lg: var(--fs-title);
  --fs-xl: var(--fs-display);
  --tap-sm: var(--tap-min);
  --chip-min: var(--tap-min);
  /* 颜色：基色 */
  --c-bg: #F3F4F1;
  --c-card: #FFFFFF;
  --c-inverse: #FFFFFF;
  --c-ink: #134E4A;
  --c-muted: #64748B;
  --c-faint: #9ca3af;
  --c-surface: #F8FAF9;
  --c-line: #F1F5F4;
  --c-line-strong: #CBD5E1;
  --c-neutral: #334155;
  /* 颜色：品牌 */
  --c-primary: #0F766E;
  --c-primary-deep: #115E59;
  --c-primary-bright: #0D9488;
  --c-primary-soft: #E6F4F1;
  --c-primary-disabled: #99B8B4;
  /* 颜色：语义 */
  --c-danger: #DC2626;
  --c-danger-soft: #FEF2F2;
  --c-ok: #047857;
  --c-ok-soft: #ECFDF5;
  --c-warn: #C2410C;
  --c-warn-soft: #FFF7ED;
  --c-info: #0E7490;
  --c-info-soft: #ECFEFF;
  --c-violet: #6D28D9;
  --c-violet-soft: #F5F3FF;
  --c-indigo: #4338CA;
  --c-indigo-soft: #EEF2FF;
  /* 颜色：深色面（看板 hero）上的文字与分隔 */
  --c-hero-ink: #ECFDF5;
  --c-hero-ink-soft: rgba(236, 253, 245, 0.72);
  --c-hero-danger: #FECACA;
  --c-hero-line: rgba(255, 255, 255, 0.16);
  /* 遮罩与投影 */
  --c-mask: rgba(15, 23, 42, 0.45);
  --shadow-card: 0 8rpx 24rpx rgba(15, 118, 110, 0.04);
  --shadow-raised: 0 12rpx 24rpx rgba(15, 118, 110, 0.28);
  --grad-hero: linear-gradient(160deg, var(--c-primary-deep) 0%, var(--c-primary) 58%, var(--c-primary-bright) 100%);
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --page-pad: var(--space-lg);
  --card-pad: 28rpx;
  --gap: var(--space-md);
  /* 字号：docs/ui-scale.md 新尺度，px × 2 = rpx */
  --fs-caption: 24rpx;
  --fs-label: 26rpx;
  --fs-body: 28rpx;
  --fs-title: 34rpx;
  --fs-amount: 32rpx;
  --fs-amount-lg: 40rpx;
  --fs-amount-lg-sm: 32rpx;
  --fs-display: 48rpx;
  --fs-hero: 80rpx;
  --fs-hero-md: 68rpx;
  --fs-hero-sm: 56rpx;
  /* 热区 */
  --tap-min: 88rpx;
  --tap-md: 96rpx;
  --tap-lg: 104rpx;
  /* 圆角 */
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 14rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  --radius-round: 40rpx;
  --radius-pill: 999rpx;
  /* 动效：本批只立 token，弹层/对话框组件后续批次消费 */
  --dur-fast: 120ms;
  --dur-base: 200ms;
  --ease-out: cubic-bezier(0.22, 0.61, 0.36, 1);
  /* 层级 */
  --z-dropdown: 20;
  --z-overlay: 1000;
  --z-sheet: 1001;
  /* 安全区 */
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  min-height: 100%;
  background: var(--c-bg);
  color: var(--c-ink);
  font-size: var(--fs-body);
  box-sizing: border-box;
}

button {
  padding: 0;
}

button::after {
  border: none;
}

.page {
  padding: var(--page-pad) var(--page-pad) calc(var(--page-pad) * 2);
  font-size: var(--fs-body);
}

.card {
  background: var(--c-card);
  border-radius: var(--radius-xl);
  padding: var(--card-pad);
  box-shadow: var(--shadow-card);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 8rpx var(--space-md);
  font-size: var(--fs-title);
  font-weight: 600;
}

.muted {
  color: var(--c-muted);
  font-size: var(--fs-label);
}

.row {
  display: flex;
  align-items: center;
}

.space {
  justify-content: space-between;
}

.btn-primary {
  height: var(--tap-lg);
  line-height: var(--tap-lg);
  background: var(--c-primary);
  color: var(--c-inverse);
  border-radius: var(--radius-lg);
  font-size: var(--fs-title);
  font-weight: 600;
}

.btn-primary[disabled] {
  background: var(--c-primary-disabled);
  color: var(--c-inverse);
}

.btn-ghost {
  height: var(--tap-md);
  line-height: var(--tap-md);
  background: var(--c-primary-soft);
  color: var(--c-primary);
  border-radius: var(--radius-md);
  font-size: var(--fs-body);
}

.btn-danger {
  height: var(--tap-lg);
  line-height: var(--tap-lg);
  background: var(--c-danger-soft);
  color: var(--c-danger);
  border-radius: var(--radius-md);
  font-size: var(--fs-body);
}

.tag {
  display: inline-block;
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-xs);
  font-size: var(--fs-caption);
}

.tag-alert {
  background: var(--c-danger-soft);
  color: var(--c-danger);
}

.tag-ok {
  background: var(--c-ok-soft);
  color: var(--c-ok);
}

.tag-in {
  background: var(--c-info-soft);
  color: var(--c-info);
}

.tag-out {
  background: var(--c-warn-soft);
  color: var(--c-warn);
}

.tag-pay {
  background: var(--c-violet-soft);
  color: var(--c-violet);
}

.tag-credit {
  background: var(--c-danger-soft);
  color: var(--c-danger);
}

.tag-spec {
  background: var(--c-info-soft);
  color: var(--c-info);
}

.tag-blank {
  background: var(--c-indigo-soft);
  color: var(--c-indigo);
}

.tag-return {
  background: var(--c-warn-soft);
  color: var(--c-warn);
}

.tag-convert {
  background: var(--c-violet-soft);
  color: var(--c-violet);
}

.tag-adjust {
  background: var(--c-line);
  color: var(--c-neutral);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap);
  margin-bottom: var(--space-md);
}

.field-input + .chips,
.axis-title + .chips {
  margin-top: var(--space-md);
}

.field-hint {
  margin-top: var(--space-md);
}

.field-hint + .chips {
  margin-top: var(--space-sm);
}

.chip {
  display: flex;
  align-items: center;
  min-height: var(--tap-min);
  padding: var(--space-sm) 28rpx;
  box-sizing: border-box;
  background: var(--c-surface);
  border-radius: var(--radius-pill);
  color: var(--c-muted);
  font-size: var(--fs-body);
  white-space: normal;
  line-height: 1.3;
}

.chip.on {
  background: var(--c-primary);
  color: var(--c-inverse);
  font-weight: 600;
}

.chip.low {
  background: var(--c-danger-soft);
  color: var(--c-danger);
}

.field {
  margin-bottom: var(--space-lg);
}

.field-label {
  color: var(--c-muted);
  font-size: var(--fs-label);
  margin-bottom: var(--space-sm);
}

.field-input {
  height: var(--tap-md);
  padding: 0 var(--space-lg);
  background: var(--c-surface);
  border-radius: var(--radius-md);
  font-size: var(--fs-body);
}

.field-input.readonly {
  line-height: var(--tap-md);
  color: var(--c-muted);
}

.field-input.picker {
  line-height: var(--tap-md);
}

.field-textarea {
  min-height: 160rpx;
  height: auto;
  padding: 20rpx var(--space-lg);
  line-height: 1.5;
  width: 100%;
  box-sizing: border-box;
}

.search {
  height: var(--tap-md);
  padding: 0 28rpx;
  background: var(--c-card);
  border-radius: var(--radius-round);
  margin-bottom: 20rpx;
  font-size: var(--fs-body);
}

.empty {
  padding: 80rpx var(--space-lg);
  text-align: center;
  color: var(--c-muted);
}

.empty-title {
  font-size: var(--fs-title);
  color: var(--c-ink);
  margin-bottom: var(--space-sm);
}

.page-loading {
  margin-top: var(--space-xl);
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-lg) var(--gap);
}

.stat {
  min-width: 0;
}

.stat-num {
  font-size: var(--fs-amount-lg);
  font-weight: 700;
}

.action-strip {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap);
  margin-top: var(--space-lg);
}

.action-strip > button {
  flex: 1 1 28%;
  min-width: 160rpx;
  margin: 0;
  box-sizing: border-box;
  white-space: normal;
  padding-left: var(--space-md);
  padding-right: var(--space-md);
}

.action-strip .btn-ghost,
.action-strip .btn-primary {
  height: auto;
  min-height: var(--tap-md);
  line-height: 1.3;
  padding-top: var(--space-sm);
  padding-bottom: var(--space-sm);
}

.action {
  min-height: var(--tap-md);
  height: auto;
  line-height: 1.3;
  padding: 20rpx var(--space-md);
  background: var(--c-primary);
  color: var(--c-inverse);
  border-radius: var(--radius-lg);
  font-size: var(--fs-title);
  white-space: normal;
}

.field-row {
  display: flex;
  gap: var(--gap);
}

.half {
  flex: 1;
  min-width: 0;
}

.seg {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap);
  margin-bottom: var(--space-sm);
}

.seg-item {
  flex: 1 1 28%;
  min-width: 160rpx;
  min-height: var(--tap-md);
  padding: var(--space-sm) var(--space-md);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: var(--c-surface);
  border-radius: var(--radius-md);
  color: var(--c-muted);
  font-size: var(--fs-body);
  white-space: normal;
  line-height: 1.3;
}

.seg-item.on {
  background: var(--c-primary);
  color: var(--c-inverse);
  font-weight: 600;
}
