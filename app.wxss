page {
  /* 旧 token 名，别名过渡（docs/ui-scale.md），新代码不要再用 */
  --fs-xs: var(--fs-caption);
  --fs-sm: var(--fs-label);
  --fs-md: var(--fs-body);
  --fs-lg: var(--fs-title);
  --fs-xl: var(--fs-display);
  --tap-sm: var(--tap-min);
  --chip-min: var(--tap-min);
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --page-pad: var(--space-lg);
  --card-pad: 28rpx;
  --gap: var(--space-md);
  /* 字号：docs/ui-scale.md 新尺度，px × 2 = rpx */
  --fs-caption: 24rpx;
  --fs-label: 26rpx;
  --fs-body: 28rpx;
  --fs-title: 34rpx;
  --fs-amount: 32rpx;
  --fs-amount-lg: 40rpx;
  --fs-amount-lg-sm: 32rpx;
  --fs-display: 48rpx;
  --fs-hero: 80rpx;
  --fs-hero-md: 68rpx;
  --fs-hero-sm: 56rpx;
  /* 热区 */
  --tap-min: 88rpx;
  --tap-md: 96rpx;
  --tap-lg: 104rpx;
  /* 圆角 */
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 14rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  --radius-round: 40rpx;
  --radius-pill: 999rpx;
  /* 动效：本批只立 token，弹层/对话框组件后续批次消费 */
  --dur-fast: 120ms;
  --dur-base: 200ms;
  --ease-out: cubic-bezier(0.22, 0.61, 0.36, 1);
  /* 层级 */
  --z-dropdown: 20;
  --z-overlay: 1000;
  --z-sheet: 1001;
  /* 安全区 */
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  min-height: 100%;
  background: #F3F4F1;
  color: #134E4A;
  font-size: var(--fs-body);
  box-sizing: border-box;
}

button {
  padding: 0;
}

button::after {
  border: none;
}

.page {
  padding: var(--page-pad) var(--page-pad) calc(var(--page-pad) * 2);
  font-size: var(--fs-body);
}

.card {
  background: #FFFFFF;
  border-radius: var(--radius-xl);
  padding: var(--card-pad);
  box-shadow: 0 8rpx 24rpx rgba(15, 118, 110, 0.04);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 8rpx var(--space-md);
  font-size: var(--fs-title);
  font-weight: 600;
}

.muted {
  color: #64748B;
  font-size: var(--fs-label);
}

.row {
  display: flex;
  align-items: center;
}

.space {
  justify-content: space-between;
}

.btn-primary {
  height: var(--tap-lg);
  line-height: var(--tap-lg);
  background: #0F766E;
  color: #FFFFFF;
  border-radius: var(--radius-lg);
  font-size: var(--fs-title);
  font-weight: 600;
}

.btn-primary[disabled] {
  background: #99B8B4;
  color: #FFFFFF;
}

.btn-ghost {
  height: var(--tap-md);
  line-height: var(--tap-md);
  background: #E6F4F1;
  color: #0F766E;
  border-radius: var(--radius-md);
  font-size: var(--fs-body);
}

.btn-danger {
  height: var(--tap-lg);
  line-height: var(--tap-lg);
  background: #FEF2F2;
  color: #DC2626;
  border-radius: var(--radius-md);
  font-size: var(--fs-body);
}

.tag {
  display: inline-block;
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-xs);
  font-size: var(--fs-caption);
}

.tag-alert {
  background: #FEF2F2;
  color: #DC2626;
}

.tag-ok {
  background: #ECFDF5;
  color: #047857;
}

.tag-in {
  background: #ECFEFF;
  color: #0E7490;
}

.tag-out {
  background: #FFF7ED;
  color: #C2410C;
}

.tag-pay {
  background: #F5F3FF;
  color: #6D28D9;
}

.tag-credit {
  background: #FEF2F2;
  color: #DC2626;
}

.tag-spec {
  background: #ECFEFF;
  color: #0E7490;
}

.tag-blank {
  background: #EEF2FF;
  color: #4338CA;
}

.tag-return {
  background: #FFF7ED;
  color: #C2410C;
}

.tag-convert {
  background: #F5F3FF;
  color: #6D28D9;
}

.tag-adjust {
  background: #F1F5F9;
  color: #334155;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap);
  margin-bottom: var(--space-md);
}

.field-input + .chips,
.axis-title + .chips {
  margin-top: var(--space-md);
}

.field-hint {
  margin-top: var(--space-md);
}

.field-hint + .chips {
  margin-top: var(--space-sm);
}

.chip {
  display: flex;
  align-items: center;
  min-height: var(--tap-min);
  padding: var(--space-sm) 28rpx;
  box-sizing: border-box;
  background: #F8FAF9;
  border-radius: var(--radius-pill);
  color: #64748B;
  font-size: var(--fs-body);
  white-space: normal;
  line-height: 1.3;
}

.chip.on {
  background: #0F766E;
  color: #FFFFFF;
  font-weight: 600;
}

.chip.low {
  background: #FEF2F2;
  color: #DC2626;
}

.field {
  margin-bottom: var(--space-lg);
}

.field-label {
  color: #64748B;
  font-size: var(--fs-label);
  margin-bottom: var(--space-sm);
}

.field-input {
  height: var(--tap-md);
  padding: 0 var(--space-lg);
  background: #F8FAF9;
  border-radius: var(--radius-md);
  font-size: var(--fs-body);
}

.field-textarea {
  min-height: 160rpx;
  height: auto;
  padding: 20rpx var(--space-lg);
  line-height: 1.5;
  width: 100%;
  box-sizing: border-box;
}

.search {
  height: var(--tap-md);
  padding: 0 28rpx;
  background: #FFFFFF;
  border-radius: var(--radius-round);
  margin-bottom: 20rpx;
  font-size: var(--fs-body);
}

.empty {
  padding: 80rpx var(--space-lg);
  text-align: center;
  color: #64748B;
}

.empty-title {
  font-size: var(--fs-title);
  color: #134E4A;
  margin-bottom: var(--space-sm);
}

.page-loading {
  margin-top: var(--space-xl);
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-lg) var(--gap);
}

.stat {
  min-width: 0;
}

.stat-num {
  font-size: var(--fs-amount-lg);
  font-weight: 700;
}

.action-strip {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap);
  margin-top: var(--space-lg);
}

.action-strip > button {
  flex: 1 1 28%;
  min-width: 160rpx;
  margin: 0;
  box-sizing: border-box;
  white-space: normal;
  padding-left: var(--space-md);
  padding-right: var(--space-md);
}

.action-strip .btn-ghost,
.action-strip .btn-primary {
  height: auto;
  min-height: var(--tap-md);
  line-height: 1.3;
  padding-top: var(--space-sm);
  padding-bottom: var(--space-sm);
}

.action {
  min-height: var(--tap-md);
  height: auto;
  line-height: 1.3;
  padding: 20rpx var(--space-md);
  background: #0F766E;
  color: #FFFFFF;
  border-radius: var(--radius-lg);
  font-size: var(--fs-title);
  white-space: normal;
}

.field-row {
  display: flex;
  gap: var(--gap);
}

.half {
  flex: 1;
  min-width: 0;
}

.seg {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap);
  margin-bottom: var(--space-sm);
}

.seg-item {
  flex: 1 1 28%;
  min-width: 160rpx;
  min-height: var(--tap-md);
  padding: var(--space-sm) var(--space-md);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #F8FAF9;
  border-radius: var(--radius-md);
  color: #64748B;
  font-size: var(--fs-body);
  white-space: normal;
  line-height: 1.3;
}

.seg-item.on {
  background: #0F766E;
  color: #FFFFFF;
  font-weight: 600;
}
