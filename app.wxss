page {
  --fs-xs: 32rpx;
  --fs-sm: 34rpx;
  --fs-md: 36rpx;
  --fs-lg: 40rpx;
  --fs-xl: 44rpx;
  --fs-hero: 48rpx;
  --tap-sm: 96rpx;
  --tap-md: 104rpx;
  --tap-lg: 112rpx;
  --chip-min: 80rpx;

  /* docs/ui-scale.md（2026-08-26 改版）的完整档位表。补全而不是只补本批要用的几个：
     文档描述的这套 token 在代码里一个都不存在，每一批 UI 都会撞到同一个洞。
     **旧的 --fs-xs/sm/md/lg/xl 和 --tap-sm/md/lg 一个都没改**：把它们重指到新值
     会一次性改掉每一页的字号和行高，那是独立的一批迁移，不该搭在面板这批里。

     三个名字在旧表里已被占用、值又对不上，本批一律不重定义（重定义会当场改掉
     不在本批范围内的页面）：
       · --fs-hero  文档 80rpx / 这里 48rpx，4 处消费（index.wxss:43,53、
         customer-edit.wxss:15、products.wxss:62）→ 原样留着，登记为遗留。
       · --tap-md   文档 96rpx / 这里 104rpx。文档的 --tap-lg(104rpx) 恰好等于
         这里的 --tap-md，主按钮就用它，用处已标注。
       · --tap-lg   文档 104rpx / 这里 112rpx。 */
  --fs-caption: 24rpx;
  --fs-label: 26rpx;
  --fs-body: 28rpx;
  --fs-title: 32rpx;
  --fs-amount: 32rpx;
  --fs-amount-lg-sm: 32rpx;
  --fs-amount-lg: 40rpx;
  --fs-display: 48rpx;
  --fs-hero-sm: 56rpx;
  --fs-hero-md: 68rpx;
  --tap-min: 88rpx;

  /* 颜色取自设计稿 Semantic 层（ui-scale.md 只管字号热区密度，没有颜色表）。
     0a 批起，app.wxss 的共用类全部消费这些变量，不再写死颜色。
     主行动一律黑是 docs/design-file.md 记的历轮刻意决策，不要回退成 brand 青绿。 */
  --color-fill-action: #171717;
  --color-fill-action-pressed: #404040;
  --color-text-primary: #171717;
  --color-text-muted: rgba(23, 23, 23, 0.62);
  --color-text-faint: rgba(23, 23, 23, 0.5);
  --color-text-on-action: #FFFFFF;
  --color-bg-card: #FFFFFF;
  --color-bg-overlay: rgba(15, 20, 26, 0.45);
  --color-border-default: rgba(23, 23, 23, 0.1);
  --color-neutral-100: #F5F5F5;
  --color-neutral-200: #E5E5E5;
  --color-neutral-600: #525252;
  --color-text-debt: #DB2626;
  /* 0a 批新增。bg/page 3:72 -> neutral/50 3:14；fill/ghost 3:91 -> neutral/100 3:15；
     border/brand 3:87 -> neutral/900 3:23；neutral/500 3:19 是禁用实底档的字色。 */
  --color-bg-page: #FAFAFA;
  --color-fill-ghost: #F5F5F5;
  --color-border-brand: #171717;
  --color-neutral-500: #737373;
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --page-pad: var(--space-lg);
  --card-pad: 28rpx;
  --gap: var(--space-md);
  min-height: 100%;
  background: var(--color-bg-page);
  color: var(--color-text-primary);
  font-size: var(--fs-md);
  box-sizing: border-box;
}

button {
  padding: 0;
}

button::after {
  border: none;
}

.page {
  padding: var(--page-pad) var(--page-pad) calc(var(--page-pad) * 2);
  font-size: var(--fs-md);
}

.card {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: var(--card-pad);
  box-shadow: 0 8rpx 24rpx rgba(15, 20, 26, 0.04);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 8rpx var(--space-md);
  font-size: var(--fs-lg);
  font-weight: 600;
}

.muted {
  color: var(--color-text-muted);
  font-size: var(--fs-sm);
}

.row {
  display: flex;
  align-items: center;
}

.space {
  justify-content: space-between;
}

.btn-primary {
  height: var(--tap-lg);
  line-height: var(--tap-lg);
  background: var(--color-fill-action);
  color: var(--color-text-on-action);
  border-radius: 16rpx;
  font-size: var(--fs-lg);
  font-weight: 600;
}

.btn-primary[disabled] {
  background: var(--color-fill-ghost);
  color: var(--color-neutral-500);
  opacity: 1;
}

.btn-ghost {
  height: var(--tap-sm);
  line-height: var(--tap-sm);
  background: var(--color-fill-ghost);
  color: var(--color-text-primary);
  border-radius: 14rpx;
  font-size: var(--fs-md);
}

.btn-danger {
  height: var(--tap-md);
  line-height: var(--tap-md);
  background: #FEF2F2;
  color: #DC2626;
  border-radius: 14rpx;
  font-size: var(--fs-md);
}

.tag {
  display: inline-block;
  padding: var(--space-xs) var(--space-md);
  border-radius: 8rpx;
  font-size: var(--fs-xs);
}

.tag-alert {
  background: #FEF2F2;
  color: #DC2626;
}

.tag-ok {
  background: #ECFDF5;
  color: #047857;
}

.tag-in {
  background: #ECFEFF;
  color: #0E7490;
}

.tag-out {
  background: #FFF7ED;
  color: #C2410C;
}

.tag-pay {
  background: #F5F3FF;
  color: #6D28D9;
}

.tag-credit {
  background: #FEF2F2;
  color: #DC2626;
}

.tag-spec {
  background: #ECFEFF;
  color: #0E7490;
}

.tag-blank {
  background: #EEF2FF;
  color: #4338CA;
}

.tag-return {
  background: #FFF7ED;
  color: #C2410C;
}

.tag-convert {
  background: #F5F3FF;
  color: #6D28D9;
}

.tag-adjust {
  background: #F1F5F9;
  color: #334155;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap);
  margin-bottom: var(--space-md);
}

.field-input + .chips,
.axis-title + .chips {
  margin-top: var(--space-md);
}

.field-hint {
  margin-top: var(--space-md);
}

.field-hint + .chips {
  margin-top: var(--space-sm);
}

.chip {
  display: flex;
  align-items: center;
  min-height: var(--chip-min);
  padding: var(--space-sm) 28rpx;
  box-sizing: border-box;
  background: var(--color-fill-ghost);
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  color: var(--color-neutral-600);
  font-size: var(--fs-sm);
  white-space: normal;
  line-height: 1.3;
}

.chip.on {
  background: var(--color-bg-card);
  border-color: var(--color-border-brand);
  color: var(--color-text-primary);
  font-weight: 600;
}

.chip.low {
  background: #FEF2F2;
  color: #DC2626;
}

.field {
  margin-bottom: var(--space-lg);
}

.field-label {
  color: var(--color-text-muted);
  font-size: var(--fs-sm);
  margin-bottom: var(--space-sm);
}

.field-input {
  height: var(--tap-md);
  padding: 0 var(--space-lg);
  background: var(--color-fill-ghost);
  border-radius: 14rpx;
  font-size: var(--fs-md);
}

.field-textarea {
  min-height: 160rpx;
  height: auto;
  padding: 20rpx var(--space-lg);
  line-height: 1.5;
  width: 100%;
  box-sizing: border-box;
}

.search {
  height: var(--tap-md);
  padding: 0 28rpx;
  background: var(--color-fill-ghost);
  border-radius: 40rpx;
  margin-bottom: 20rpx;
  font-size: var(--fs-md);
}

.empty {
  padding: 80rpx var(--space-lg);
  text-align: center;
  color: var(--color-text-muted);
}

.empty-title {
  font-size: var(--fs-lg);
  color: var(--color-text-primary);
  margin-bottom: var(--space-sm);
}

.page-loading {
  margin-top: var(--space-xl);
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-lg) var(--gap);
}

.stat {
  min-width: 0;
}

.stat-num {
  font-size: var(--fs-lg);
  font-weight: 700;
}

.action-strip {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap);
  margin-top: var(--space-lg);
}

.action-strip > button {
  flex: 1 1 28%;
  min-width: 160rpx;
  margin: 0;
  box-sizing: border-box;
  white-space: normal;
  padding-left: var(--space-md);
  padding-right: var(--space-md);
}

.action-strip .btn-ghost,
.action-strip .btn-primary {
  height: auto;
  min-height: var(--tap-sm);
  line-height: 1.3;
  padding-top: var(--space-sm);
  padding-bottom: var(--space-sm);
}

.action {
  min-height: var(--tap-md);
  height: auto;
  line-height: 1.3;
  padding: 20rpx var(--space-md);
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border-brand);
  color: var(--color-text-primary);
  border-radius: 16rpx;
  font-size: var(--fs-lg);
  white-space: normal;
}

.field-row {
  display: flex;
  gap: var(--gap);
}

.half {
  flex: 1;
  min-width: 0;
}

.seg {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap);
  margin-bottom: var(--space-sm);
}

.seg-item {
  flex: 1 1 28%;
  min-width: 160rpx;
  min-height: var(--tap-sm);
  padding: var(--space-sm) var(--space-md);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: var(--color-fill-ghost);
  border: 2rpx solid transparent;
  border-radius: 14rpx;
  color: var(--color-neutral-500);
  font-size: var(--fs-md);
  white-space: normal;
  line-height: 1.3;
}

.seg-item.on {
  background: var(--color-bg-card);
  border-color: var(--color-border-brand);
  color: var(--color-text-primary);
  font-weight: 600;
}
