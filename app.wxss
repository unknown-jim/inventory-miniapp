page {
  --fs-xs: 32rpx;
  --fs-sm: 34rpx;
  --fs-md: 36rpx;
  --fs-lg: 40rpx;
  --fs-xl: 44rpx;
  --fs-hero: 48rpx;
  --tap-sm: 96rpx;
  --tap-md: 104rpx;
  --tap-lg: 112rpx;
  --chip-min: 80rpx;
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --page-pad: var(--space-lg);
  --card-pad: 28rpx;
  --gap: var(--space-md);
  min-height: 100%;
  background: #F3F4F1;
  color: #134E4A;
  font-size: var(--fs-md);
  box-sizing: border-box;
}

button {
  padding: 0;
}

button::after {
  border: none;
}

.page {
  padding: var(--page-pad) var(--page-pad) calc(var(--page-pad) * 2);
  font-size: var(--fs-md);
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: var(--card-pad);
  box-shadow: 0 8rpx 24rpx rgba(15, 118, 110, 0.04);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 8rpx var(--space-md);
  font-size: var(--fs-lg);
  font-weight: 600;
}

.muted {
  color: #64748B;
  font-size: var(--fs-sm);
}

.row {
  display: flex;
  align-items: center;
}

.space {
  justify-content: space-between;
}

.btn-primary {
  height: var(--tap-lg);
  line-height: var(--tap-lg);
  background: #0F766E;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: var(--fs-lg);
  font-weight: 600;
}

.btn-primary[disabled] {
  background: #99B8B4;
  color: #FFFFFF;
}

.btn-ghost {
  height: var(--tap-sm);
  line-height: var(--tap-sm);
  background: #E6F4F1;
  color: #0F766E;
  border-radius: 14rpx;
  font-size: var(--fs-md);
}

.btn-danger {
  height: var(--tap-md);
  line-height: var(--tap-md);
  background: #FEF2F2;
  color: #DC2626;
  border-radius: 14rpx;
  font-size: var(--fs-md);
}

.tag {
  display: inline-block;
  padding: var(--space-xs) var(--space-md);
  border-radius: 8rpx;
  font-size: var(--fs-xs);
}

.tag-alert {
  background: #FEF2F2;
  color: #DC2626;
}

.tag-ok {
  background: #ECFDF5;
  color: #047857;
}

.tag-in {
  background: #ECFEFF;
  color: #0E7490;
}

.tag-out {
  background: #FFF7ED;
  color: #C2410C;
}

.tag-pay {
  background: #F5F3FF;
  color: #6D28D9;
}

.tag-credit {
  background: #FEF2F2;
  color: #DC2626;
}

.tag-spec {
  background: #ECFEFF;
  color: #0E7490;
}

.tag-blank {
  background: #EEF2FF;
  color: #4338CA;
}

.tag-return {
  background: #FFF7ED;
  color: #C2410C;
}

.tag-convert {
  background: #F5F3FF;
  color: #6D28D9;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap);
  margin-bottom: var(--space-md);
}

.chip {
  display: flex;
  align-items: center;
  min-height: var(--chip-min);
  padding: var(--space-sm) 28rpx;
  box-sizing: border-box;
  background: #F8FAF9;
  border-radius: 999rpx;
  color: #64748B;
  font-size: var(--fs-sm);
  white-space: normal;
  line-height: 1.3;
}

.chip.on {
  background: #0F766E;
  color: #FFFFFF;
  font-weight: 600;
}

.chip.low {
  background: #FEF2F2;
  color: #DC2626;
}

.field {
  margin-bottom: var(--space-lg);
}

.field-label {
  color: #64748B;
  font-size: var(--fs-sm);
  margin-bottom: var(--space-sm);
}

.field-input {
  height: var(--tap-md);
  padding: 0 var(--space-lg);
  background: #F8FAF9;
  border-radius: 14rpx;
  font-size: var(--fs-md);
}

.field-textarea {
  min-height: 160rpx;
  height: auto;
  padding: 20rpx var(--space-lg);
  line-height: 1.5;
  width: 100%;
  box-sizing: border-box;
}

.search {
  height: var(--tap-md);
  padding: 0 28rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  margin-bottom: 20rpx;
  font-size: var(--fs-md);
}

.empty {
  padding: 80rpx var(--space-lg);
  text-align: center;
  color: #64748B;
}

.empty-title {
  font-size: var(--fs-lg);
  color: #134E4A;
  margin-bottom: var(--space-sm);
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-lg) var(--gap);
}

.stat {
  min-width: 0;
}

.stat-num {
  font-size: var(--fs-lg);
  font-weight: 700;
}

.action-strip {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap);
  margin-top: var(--space-lg);
}

.action-strip > * {
  flex: 1 1 28%;
  min-width: 160rpx;
  margin: 0;
  box-sizing: border-box;
  white-space: normal;
  padding-left: var(--space-md);
  padding-right: var(--space-md);
}

.action-strip .btn-ghost,
.action-strip .btn-primary {
  height: auto;
  min-height: var(--tap-sm);
  line-height: 1.3;
  padding-top: var(--space-sm);
  padding-bottom: var(--space-sm);
}

.action {
  min-height: var(--tap-md);
  height: auto;
  line-height: 1.3;
  padding: 20rpx var(--space-md);
  background: #0F766E;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: var(--fs-lg);
  white-space: normal;
}

.field-row {
  display: flex;
  gap: var(--gap);
}

.half {
  flex: 1;
  min-width: 0;
}

.seg {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap);
  margin-bottom: var(--space-sm);
}

.seg-item {
  flex: 1 1 28%;
  min-width: 160rpx;
  min-height: var(--tap-sm);
  padding: var(--space-sm) var(--space-md);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #F8FAF9;
  border-radius: 14rpx;
  color: #64748B;
  font-size: var(--fs-md);
  white-space: normal;
  line-height: 1.3;
}

.seg-item.on {
  background: #0F766E;
  color: #FFFFFF;
  font-weight: 600;
}
