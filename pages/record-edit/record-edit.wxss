.form-card {
  margin-top: 16rpx;
}

.readonly {
  line-height: var(--tap-md);
  color: #64748B;
}

.picker {
  line-height: var(--tap-md);
}

.customer-meta {
  margin: -8rpx 0 24rpx;
  color: #64748B;
  font-size: var(--fs-sm);
}

.meta {
  margin: -8rpx 0 24rpx;
  color: #0F766E;
  font-size: var(--fs-sm);
}

.order-lines {
  margin-bottom: 8rpx;
}

.line-block {
  padding: 8rpx 0 4rpx;
  border-bottom: 1rpx solid #F1F5F4;
}

.line-block:last-child {
  border-bottom: none;
}

.line-block .item-name {
  margin-top: 8rpx;
}

.line-block .meta {
  margin-top: -8rpx;
}

.total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  font-weight: 600;
}

.total-num {
  font-size: var(--fs-xl);
  color: #C2410C;
}

.tip {
  margin: 16rpx 8rpx 0;
}

.last {
  margin-bottom: 0;
}

.export-btn {
  margin: 32rpx 0 16rpx;
}

.save-btn {
  margin: 32rpx 0 16rpx;
}

.export-btn + .save-btn {
  margin-top: 0;
}

.cancel-btn {
  margin: 0 0 16rpx;
}

.link {
  color: #0F766E;
  font-size: var(--fs-sm);
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 24rpx 12rpx;
  position: relative;
  z-index: 1001;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.sheet-head .sheet-title {
  margin-bottom: 0;
}

.sheet-title {
  font-size: var(--fs-lg);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.sheet-list {
  height: 560rpx;
}

.sheet-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}

.item-name {
  font-weight: 600;
  margin-bottom: 6rpx;
}

.slip-canvas {
  position: fixed;
  /* 挪出屏幕，避免 type=2d 原生组件盖住按钮；宽高由导出时写入，必须 ≥ dest 像素 */
  left: -20000px;
  top: 0;
  pointer-events: none;
  opacity: 0;
}

.paid-note {
  margin: 12rpx 0 4rpx;
  font-size: var(--fs-sm);
  font-weight: 600;
}

.paid-note.debt {
  color: #C2410C;
}

.paid-note.over {
  color: #DC2626;
}

.paid-note.done {
  color: #0F766E;
}
