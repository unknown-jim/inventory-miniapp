@import '/styles/slip.wxss';

.form-card {
  margin-top: 16rpx;
}

.readonly {
  line-height: 80rpx;
  color: #64748B;
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.half {
  flex: 1;
}

.picker {
  line-height: 80rpx;
}

.customer-meta {
  margin: -8rpx 0 24rpx;
  color: #64748B;
  font-size: 24rpx;
}

.pay-tabs {
  display: flex;
  gap: 12rpx;
}

.pay-tab {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #F8FAF9;
  border-radius: 14rpx;
  color: #64748B;
  font-size: 28rpx;
}

.pay-tab.on {
  background: #0F766E;
  color: #FFFFFF;
  font-weight: 600;
}

.meta {
  margin: -8rpx 0 24rpx;
  color: #0F766E;
  font-size: 24rpx;
}

.total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  font-weight: 600;
}

.total-num {
  font-size: 36rpx;
  color: #C2410C;
}

.tip {
  margin: 16rpx 8rpx 0;
}

.last {
  margin-bottom: 0;
}

.export-btn {
  margin: 32rpx 0 16rpx;
}

.save-btn {
  margin: 32rpx 0 16rpx;
}

.export-btn + .save-btn {
  margin-top: 0;
}

.link {
  color: #0F766E;
  font-size: 24rpx;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 24rpx 12rpx;
  position: relative;
  z-index: 1001;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.sheet-head .sheet-title {
  margin-bottom: 0;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.sheet-list {
  height: 560rpx;
}

.sheet-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}

.item-name {
  font-weight: 600;
  margin-bottom: 6rpx;
}
