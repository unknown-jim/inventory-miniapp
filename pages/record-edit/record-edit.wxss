.form-card {
  margin-top: 16rpx;
}

.customer-meta {
  margin: -8rpx 0 24rpx;
  color: var(--c-muted);
  font-size: var(--fs-label);
}

.meta {
  margin: -8rpx 0 24rpx;
  color: var(--c-primary);
  font-size: var(--fs-label);
}

.order-lines {
  margin-bottom: 8rpx;
}

.line-block {
  padding: 8rpx 0 4rpx;
  border-bottom: 1rpx solid var(--c-line);
}

.line-block:last-child {
  border-bottom: none;
}

.line-block .item-name {
  margin-top: 8rpx;
}

.line-block .meta {
  margin-top: -8rpx;
}

.total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  font-weight: 600;
}

/* 字号归 amount 组件（display 角色 48rpx）；这里只留颜色 */
.total-num {
  color: var(--c-warn);
}

.tip {
  margin: 16rpx 8rpx 0;
}

.export-btn {
  margin: 32rpx 0 16rpx;
}

.save-btn {
  margin: 32rpx 0 16rpx;
}

.export-btn + .save-btn {
  margin-top: 0;
}

.cancel-btn {
  margin: 0 0 16rpx;
}

.link {
  color: var(--c-primary);
  font-size: var(--fs-label);
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.sheet-head .sheet-title {
  margin-bottom: 0;
}

.sheet-title {
  font-size: var(--fs-title);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.sheet-list {
  height: 560rpx;
}

.sheet-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--c-line);
}

.item-name {
  font-weight: 600;
  margin-bottom: 6rpx;
}

.slip-canvas {
  position: fixed;
  /* 挪出屏幕，避免 type=2d 原生组件盖住按钮；宽高由导出时写入，必须 ≥ dest 像素 */
  left: -20000px;
  top: 0;
  pointer-events: none;
  opacity: 0;
}

.paid-note {
  margin: 12rpx 0 4rpx;
  font-size: var(--fs-label);
  font-weight: 600;
}

.paid-note.debt {
  color: var(--c-warn);
}

.paid-note.over {
  color: var(--c-danger);
}

.paid-note.done {
  color: var(--c-primary);
}
