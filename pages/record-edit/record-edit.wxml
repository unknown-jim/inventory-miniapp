<view class="page">
  <!-- 单据信息卡。稿 card/单据信息 4:195：row/type（tag + 单号）+ 三行 kv。
       kv 的 k 定宽 56px = 112rpx（稿 4:200 / 4:203 / 4:206 逐个实读）。
       时间用**绝对日期**（稿 4:204「2026-08-25 14:32」；演示账对照表 9:18：
       「流水列表用相对时间，单据详情与原单用绝对日期」）。 -->
  <view class="card info-card">
    <view class="info-head">
      <text class="tag {{tagClass}}">{{isAdjust ? directionTagText : typeText}}</text>
      <text class="doc-no js-doc-no">{{docNoText}}</text>
    </view>
    <view class="kv" wx:if="{{customerName && (isOut || isPay || isOpening || isReturn)}}">
      <view class="kv-k">客户</view>
      <view class="kv-v">{{customerName}}</view>
    </view>
    <view class="kv" wx:if="{{customerPhone || customerAddress}}">
      <view class="kv-k">联系</view>
      <view class="kv-v">{{customerPhone}}<text wx:if="{{customerPhone && customerAddress}}"> · </text>{{customerAddress}}</view>
    </view>
    <!-- 稿 n4 4:233：进货单无客户 / 欠款行；收款单无商品清单、只有金额卡；
         改规格单展示来源→目标两行；调整单只记件数无金额。 -->
    <view class="kv" wx:if="{{!isOut && !isReturn && !isPay && !isOpening}}">
      <view class="kv-k">商品</view>
      <view class="kv-v">{{productName}}</view>
    </view>
    <view class="kv" wx:if="{{specText && !isOut && !isReturn}}">
      <view class="kv-k">规格</view>
      <view class="kv-v">{{specText}}</view>
    </view>
    <view class="kv">
      <view class="kv-k">时间</view>
      <view class="kv-v">{{timeText}}</view>
    </view>
    <view class="kv" wx:if="{{isOut}}">
      <view class="kv-k">经手人</view>
      <view class="kv-v">{{operatorName || '—'}}</view>
    </view>
  </view>

  <!-- ============ 只读态：商品清单（稿 card/商品清单 4:208） ============ -->
  <!-- 稿 n1 4:230：清单行标已退数量（已退 1）。 -->
  <view class="card lines-card" wx:if="{{!editing && (isOut || isReturn) && lines.length}}">
    <view class="line-row" wx:for="{{lines}}" wx:key="id">
      <view class="line-col">
        <view class="line-title">{{item.productName}}</view>
        <view class="line-sub">{{item.subText}}</view>
      </view>
      <view class="line-amount">¥{{item.amountText}}</view>
    </view>
  </view>

  <!-- ============ 只读态：实收卡（稿 card/实收 4:212 / 欠款变体 7:84） ============ -->
  <view class="card money-card" wx:if="{{!editing && isOut}}">
    <view class="kv">
      <view class="kv-k grow">应收</view>
      <view class="money-v">¥{{amountText}}</view>
    </view>
    <view class="kv">
      <view class="kv-k grow">实收</view>
      <view class="money-v">¥{{paidAmount}}</view>
    </view>
    <!-- 稿 4:213 那一档没有这行；有抵扣才出（B6 的 G1 契约：prepayUsed 为 0 时
         逐字段与改动前相同）。 -->
    <view class="kv" wx:if="{{hasPrepayUsed}}">
      <view class="kv-k grow">抵预收</view>
      <view class="money-v js-prepay-used">¥{{prepayUsedText}}</view>
    </view>
    <!-- 稿 row/已退 4:279 + 已退去向 13:273。UX注释 n6 4:282：
         「有退货的单：实收卡加冲减行（已退 = 冲欠款 + 退现金）」。 -->
    <block wx:if="{{hasReturned}}">
      <view class="kv">
        <view class="kv-k grow">已退</view>
        <view class="money-v js-returned">−¥{{returnedText}}</view>
      </view>
      <view class="money-note">{{returnSplitText}}</view>
    </block>
    <view class="money-div"></view>
    <view class="kv">
      <view class="kv-k grow">欠款（当前）</view>
      <view class="money-v {{hasDebtNow ? 'debt' : 'muted-v'}} js-debt-now">{{debtNowText}}</view>
    </view>
    <!-- 「去收款」桥。稿 btn/去收款 13:446 在 card/操作区·欠款变体 7:84 里，
         UX注释 n8 7:87 原话：「去收款在实收卡内、欠款行下方（变体 7:84 画的是
         对的），**不要把钮搬到操作区**」。
         docs/design-file.md 的铁律：只在**仍有剩余欠款**时出现，冲完即清不带桥。 -->
    <button
      wx:if="{{canCollect}}"
      class="btn-primary collect-btn js-go-collect"
      bindtap="goCollect"
      hidden="{{showSlip}}"
    >去收款 · 欠款 ¥{{debtNowAmountText}}</button>
  </view>

  <!-- 收款 / 期初：只有金额卡（稿 n4 4:233）。 -->
  <view class="card money-card" wx:if="{{!editing && (isPay || isOpening)}}">
    <view class="kv">
      <view class="kv-k grow">{{isOpening ? '期初欠款' : '收款金额'}}</view>
      <view class="money-v">¥{{amountText}}</view>
    </view>
  </view>

  <!-- 进货 / 改规格 / 退货（单行）/ 调整：金额或件数（稿 n4 4:233）。 -->
  <view class="card money-card" wx:if="{{!editing && !isOut && !isPay && !isOpening && !(isReturn && isMulti)}}">
    <view class="kv">
      <view class="kv-k grow">数量</view>
      <view class="money-v">{{qty}} 件</view>
    </view>
    <view class="kv" wx:if="{{!isAdjust}}">
      <view class="kv-k grow">{{isIn ? '进价' : '退货单价'}}</view>
      <view class="money-v">¥{{priceText}}</view>
    </view>
    <view class="kv" wx:if="{{!isAdjust}}">
      <view class="kv-k grow">金额</view>
      <view class="money-v">¥{{amountText}}</view>
    </view>
  </view>

  <view class="card money-card" wx:if="{{!editing && isReturn && isMulti}}">
    <view class="kv">
      <view class="kv-k grow">本单金额</view>
      <view class="money-v">¥{{amountText}}</view>
    </view>
  </view>

  <view class="card note-card" wx:if="{{!editing && remark}}">
    <view class="kv-k">备注</view>
    <view class="note-body">{{remark}}</view>
  </view>

  <!-- ============ 编辑态 ============ -->
  <!-- 稿上没有 07 的编辑态变体（n5 4:234 只说「操作区「修改」进编辑态」）。
       所以编辑态**沿用改版前的表单版式**，只把配色 / 字号迁到新档位，不发明新版式。
       见规格 §6「与稿的已知偏差 ②」。 -->

  <view class="card form-card" wx:if="{{editing && (isPay || isOpening)}}">
    <view class="field">
      <view class="field-label">{{isOpening ? '期初欠款' : '收款金额'}}</view>
      <input class="field-input" type="digit" data-field="amount" value="{{amount}}" bindinput="onField" placeholder="0.00" />
    </view>
    <view class="field last">
      <view class="field-label">备注</view>
      <input class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="可选" />
    </view>
  </view>

  <view class="card form-card" wx:elif="{{editing && isOut}}">
    <view class="field">
      <view class="field-label">客户</view>
      <view class="field-input picker" bindtap="openCustomerPicker">{{customerName}}</view>
    </view>
    <view class="customer-meta" wx:if="{{customerPhone || customerAddress}}">
      {{customerPhone}}<text wx:if="{{customerPhone && customerAddress}}"> · </text>{{customerAddress}}
    </view>
    <view class="field">
      <view class="field-label">经手人</view>
      <input class="field-input" maxlength="32" value="{{operatorName}}" bindinput="onOperatorName" placeholder="可选" hidden="{{showCustomerPicker || showSlip}}" />
      <view wx:if="{{members.length}}" class="muted field-hint">点选本店成员，也可手写</view>
      <view class="chips" wx:if="{{members.length}}">
        <view
          class="chip {{item.on ? 'on' : ''}}"
          wx:for="{{members}}"
          wx:key="openid"
          data-openid="{{item.openid}}"
          bindtap="pickOperator"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="order-lines">
      <view class="line-block" wx:for="{{lines}}" wx:key="id">
        <view class="line-title">{{item.productName}}</view>
        <view class="muted" wx:if="{{item.hasSpec}}">{{item.specText}}</view>
        <view class="field-row">
          <view class="field half">
            <view class="field-label">数量</view>
            <input class="field-input" type="digit" data-id="{{item.id}}" data-field="qty" value="{{item.qty}}" bindinput="onLineField" placeholder="0" hidden="{{showCustomerPicker}}" />
          </view>
          <view class="field half">
            <view class="field-label">售价</view>
            <input class="field-input" type="digit" data-id="{{item.id}}" data-field="unitPrice" value="{{item.unitPrice}}" bindinput="onLineField" placeholder="0.00" hidden="{{showCustomerPicker}}" />
          </view>
        </view>
        <view class="line-meta">进价快照 ¥{{item.costText}} · 本行毛利 ¥{{item.profitText}}</view>
      </view>
    </view>
    <view class="total">
      <text>本单应收</text>
      <text class="total-num">¥{{amountText}}</text>
    </view>
    <view class="field">
      <view class="field-label">本单实收</view>
      <input class="field-input js-paid" type="digit" value="{{paidAmount}}" bindinput="onPaidInput" placeholder="0.00" hidden="{{showCustomerPicker || showSlip}}" />
      <view class="chips">
        <view class="chip js-paid-full" bindtap="fillPaidFull">收满 ¥{{cashDueText}}</view>
        <view class="chip js-paid-none" bindtap="fillPaidNone">一分未收</view>
      </view>
    </view>
    <view class="paid-note {{paidNoteTone}}">{{paidNote}}</view>
    <view class="field last">
      <view class="field-label">备注</view>
      <input class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="可选" hidden="{{showCustomerPicker}}" />
    </view>
  </view>

  <view class="card form-card" wx:elif="{{editing && isReturn && isMulti}}">
    <view class="order-lines">
      <view class="line-block" wx:for="{{lines}}" wx:key="id">
        <view class="line-title">{{item.productName}}</view>
        <view class="muted" wx:if="{{item.hasSpec}}">{{item.specText}}</view>
        <view class="field">
          <view class="field-label">退货数量</view>
          <input class="field-input" type="digit" data-id="{{item.id}}" data-field="qty" value="{{item.qty}}" bindinput="onLineField" placeholder="0" hidden="{{showCustomerPicker}}" />
        </view>
        <view class="line-meta">退货单价 ¥{{item.priceText}} · 进价快照 ¥{{item.costText}} · 本行冲减毛利 ¥{{item.profitText}}</view>
      </view>
    </view>
    <view class="total">
      <text>本单金额</text>
      <text class="total-num">¥{{amountText}}</text>
    </view>
    <view class="field last">
      <view class="field-label">备注</view>
      <input class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="可选" hidden="{{showCustomerPicker}}" />
    </view>
  </view>

  <view class="card form-card" wx:elif="{{editing && isAdjust}}">
    <view class="field">
      <view class="field-label">原因</view>
      <view class="chips">
        <view
          class="chip {{item.on ? 'on' : ''}}"
          wx:for="{{reasonOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="pickReason"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="field">
      <view class="field-label">数量</view>
      <input class="field-input" type="digit" data-field="qty" value="{{qty}}" bindinput="onField" placeholder="0" hidden="{{showCustomerPicker}}" />
    </view>
    <view class="field last">
      <view class="field-label">备注</view>
      <input class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="{{reason === 'other' ? '必填，说明原因' : '可选'}}" hidden="{{showCustomerPicker}}" />
    </view>
  </view>

  <view class="card form-card" wx:elif="{{editing}}">
    <view class="field-row">
      <view class="field {{isConvert ? 'last' : 'half'}}">
        <view class="field-label">数量</view>
        <input class="field-input" type="digit" data-field="qty" value="{{qty}}" bindinput="onField" placeholder="0" hidden="{{showCustomerPicker}}" />
      </view>
      <view class="field half" wx:if="{{!isConvert}}">
        <view class="field-label">{{isIn ? '进价' : '退货单价'}}</view>
        <input wx:if="{{!isReturn}}" class="field-input" type="digit" data-field="unitPrice" value="{{unitPrice}}" bindinput="onField" placeholder="0.00" hidden="{{showCustomerPicker}}" />
        <view wx:else class="field-input readonly">{{unitPrice}}</view>
      </view>
    </view>
    <view class="line-meta" wx:if="{{isReturn}}">进价快照 ¥{{costText}} · 本行毛利 ¥{{profitText}}</view>
    <view class="total">
      <text>金额</text>
      <text class="total-num">¥{{amountText}}</text>
    </view>
    <view class="field last">
      <view class="field-label">备注</view>
      <input class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="可选" hidden="{{showCustomerPicker}}" />
    </view>
  </view>

  <view class="muted tip" wx:if="{{isOpening}}">期初欠款不改库存，也不计入销售和毛利。</view>
  <view class="muted tip" wx:elif="{{isPay}}">收款只冲减欠款，不改库存。</view>
  <view class="muted tip" wx:elif="{{isAdjust}}">{{adjustHint}}</view>
  <view class="muted tip" wx:elif="{{editing}}">改数量会同步改库存。记错商品请删除后重新开单。<text wx:if="{{isOut}}">删除销售会去掉本单全部商品。同一张送货单的客户、实收和备注会一起改。</text></view>

  <!-- 操作区。稿 4:223：vertical gap 16。
       三档（稿 pay-variant-caption 7:83 原话）：
         主动作实心黑唯一 —— 本屏的实心黑是实收卡里的「去收款」，操作区里没有；
         次级白底描边 48·r8（≤3 个）—— 退货入库 / 修改 / 导出送货单；
         危险红字链 44 —— 删除流水。
       编辑态里「保存 / 取消」仍用主次两档（稿没画编辑态操作区，见 §6 偏差 ②）。 -->
  <view class="actions" wx:if="{{!editing}}" hidden="{{showCustomerPicker || showSlip}}">
    <button wx:if="{{canReturn}}" class="action js-go-return" bindtap="goReturn">退货入库</button>
    <view class="action-row">
      <button class="action js-edit" bindtap="startEdit">修改</button>
      <button wx:if="{{isOut}}" class="action js-export-slip" bindtap="openSlip">导出送货单</button>
    </view>
    <view class="danger-link js-remove" bindtap="remove">删除流水</view>
  </view>

  <view class="actions" wx:else hidden="{{showCustomerPicker || showSlip}}">
    <button class="btn-primary js-save" bindtap="save">保存</button>
    <button class="action js-cancel" bindtap="cancelEdit">取消</button>
  </view>

  <view wx:if="{{showCustomerPicker}}" class="mask" bindtap="closeCustomerPicker">
    <view class="sheet" catchtap="closePickerKeep">
      <view class="sheet-head">
        <view class="sheet-title">选择客户</view>
        <text class="link" catchtap="goAddCustomer">新增</text>
      </view>
      <input class="search" placeholder="搜索客户" value="{{customerKeyword}}" bindinput="onCustomerSearch" />
      <scroll-view scroll-y class="sheet-list">
        <view class="sheet-item" bindtap="clearCustomer">
          <view>
            <view class="line-title">散客</view>
            <view class="muted">不填写客户</view>
          </view>
        </view>
        <view
          class="sheet-item"
          wx:for="{{filteredCustomers}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPickCustomer"
        >
          <view>
            <view class="line-title">{{item.name}}</view>
            <view class="muted">{{item.phone || '未填电话'}} · {{item.address || '未填地址'}}</view>
          </view>
        </view>
        <view wx:if="{{!filteredCustomers.length}}" class="empty">没有匹配客户</view>
      </scroll-view>
    </view>
  </view>

  <slip-overlay
    id="slip-overlay"
    show-slip="{{showSlip}}"
    slip="{{slip}}"
    exporting="{{exporting}}"
    show-picker="{{showPicker}}"
    show-customer-picker="{{showCustomerPicker}}"
    bind:close="closeSlip"
    bind:export="exportSlip"
  />
  <canvas type="2d" id="slipCanvas" class="slip-canvas" style="width: {{slipCanvasWidth}}px; height: {{slipCanvasHeight}}px;"></canvas>
</view>
