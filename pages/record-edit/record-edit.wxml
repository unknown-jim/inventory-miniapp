<view class="page">
  <view class="card">
    <view class="field" wx:if="{{isAdjust}}">
      <view class="field-label">方向</view>
      <view class="field-input readonly">{{directionText}}</view>
    </view>
    <view class="field" wx:else>
      <view class="field-label">类型</view>
      <view class="field-input readonly">{{typeText}}</view>
    </view>
    <view class="field" wx:if="{{isPay || isOpening}}">
      <view class="field-label">客户</view>
      <view class="field-input readonly">{{customerName}}</view>
    </view>
    <view class="field" wx:if="{{!isPay && !isOpening && !isOut}}">
      <view class="field-label">商品</view>
      <view class="field-input readonly">{{productName}}</view>
    </view>
    <view class="field" wx:if="{{specText && !isOut}}">
      <view class="field-label">规格</view>
      <view class="field-input readonly">{{specText}}</view>
    </view>
    <view class="field last">
      <view class="field-label">时间</view>
      <view class="field-input readonly">{{timeText}}</view>
    </view>
  </view>

  <view class="card form-card" wx:if="{{isPay || isOpening}}">
    <view class="field">
      <view class="field-label">{{isOpening ? '期初欠款' : '收款金额'}}</view>
      <input wx:if="{{editing}}" class="field-input" type="digit" data-field="amount" value="{{amount}}" bindinput="onField" placeholder="0.00" hidden="{{showCustomerPicker}}" />
      <view wx:else class="field-input readonly">{{amount}}</view>
    </view>
    <view class="field last">
      <view class="field-label">备注</view>
      <input wx:if="{{editing}}" class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="可选" hidden="{{showCustomerPicker}}" />
      <view wx:else class="field-input readonly">{{remark}}</view>
    </view>
  </view>

  <view class="card form-card" wx:elif="{{isOut}}">
    <view class="field">
      <view class="field-label">客户</view>
      <view wx:if="{{editing}}" class="field-input picker" bindtap="openCustomerPicker">{{customerName}}</view>
      <view wx:else class="field-input readonly">{{customerName}}</view>
    </view>
    <view class="customer-meta" wx:if="{{customerPhone || customerAddress}}">
      {{customerPhone}}<text wx:if="{{customerPhone && customerAddress}}"> · </text>{{customerAddress}}
    </view>
    <view class="field">
      <view class="field-label">结算</view>
      <view wx:if="{{editing}}" class="seg">
        <view class="seg-item {{payType === 'cash' ? 'on' : ''}}" data-type="cash" bindtap="setPayType">现结</view>
        <view class="seg-item {{payType === 'credit' ? 'on' : ''}}" data-type="credit" bindtap="setPayType">赊账</view>
      </view>
      <view wx:else class="field-input readonly">{{payTypeText}}</view>
    </view>
    <view class="order-lines">
      <view class="line-block" wx:for="{{lines}}" wx:key="id">
        <view class="item-name">{{item.productName}}</view>
        <view class="muted" wx:if="{{item.hasSpec}}">{{item.specText}}</view>
        <view class="field-row">
          <view class="field half">
            <view class="field-label">数量</view>
            <input wx:if="{{editing}}" class="field-input" type="digit" data-id="{{item.id}}" data-field="qty" value="{{item.qty}}" bindinput="onLineField" placeholder="0" hidden="{{showCustomerPicker}}" />
            <view wx:else class="field-input readonly">{{item.qty}}</view>
          </view>
          <view class="field half">
            <view class="field-label">售价</view>
            <input wx:if="{{editing}}" class="field-input" type="digit" data-id="{{item.id}}" data-field="unitPrice" value="{{item.unitPrice}}" bindinput="onLineField" placeholder="0.00" hidden="{{showCustomerPicker}}" />
            <view wx:else class="field-input readonly">{{item.unitPrice}}</view>
          </view>
        </view>
        <view class="meta">进价快照 ¥{{item.costText}} · 本行毛利 ¥{{item.profitText}}</view>
      </view>
    </view>
    <view class="total">
      <text>本单金额</text>
      <text class="total-num">¥{{amountText}}</text>
    </view>
    <view class="field last">
      <view class="field-label">备注</view>
      <input wx:if="{{editing}}" class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="可选" hidden="{{showCustomerPicker}}" />
      <view wx:else class="field-input readonly">{{remark}}</view>
    </view>
  </view>

  <view class="card form-card" wx:elif="{{isAdjust}}">
    <view class="field">
      <view class="field-label">原因</view>
      <view wx:if="{{editing}}" class="chips">
        <view
          class="chip {{item.on ? 'on' : ''}}"
          wx:for="{{reasonOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="pickReason"
        >{{item.label}}</view>
      </view>
      <view wx:else class="field-input readonly">{{typeText}}</view>
    </view>
    <view class="field">
      <view class="field-label">数量</view>
      <input wx:if="{{editing}}" class="field-input" type="digit" data-field="qty" value="{{qty}}" bindinput="onField" placeholder="0" hidden="{{showCustomerPicker}}" />
      <view wx:else class="field-input readonly">{{qty}}</view>
    </view>
    <view class="field last">
      <view class="field-label">备注</view>
      <input wx:if="{{editing}}" class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="{{reason === 'other' ? '必填，说明原因' : '可选'}}" hidden="{{showCustomerPicker}}" />
      <view wx:else class="field-input readonly">{{remark}}</view>
    </view>
  </view>

  <view class="card form-card" wx:else>
    <view class="field-row">
      <view class="field {{isConvert ? 'last' : 'half'}}">
        <view class="field-label">数量</view>
        <input wx:if="{{editing}}" class="field-input" type="digit" data-field="qty" value="{{qty}}" bindinput="onField" placeholder="0" hidden="{{showCustomerPicker}}" />
        <view wx:else class="field-input readonly">{{qty}}</view>
      </view>
      <view class="field half" wx:if="{{!isConvert}}">
        <view class="field-label">{{isIn ? '进价' : '退货单价'}}</view>
        <input wx:if="{{editing && !isReturn}}" class="field-input" type="digit" data-field="unitPrice" value="{{unitPrice}}" bindinput="onField" placeholder="0.00" hidden="{{showCustomerPicker}}" />
        <view wx:else class="field-input readonly">{{unitPrice}}</view>
      </view>
    </view>
    <view class="meta" wx:if="{{isReturn}}">进价快照 ¥{{costText}} · 本行毛利 ¥{{profitText}}</view>
    <view class="total">
      <text>金额</text>
      <text class="total-num">¥{{amountText}}</text>
    </view>
    <view class="field last">
      <view class="field-label">备注</view>
      <input wx:if="{{editing}}" class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="可选" hidden="{{showCustomerPicker}}" />
      <view wx:else class="field-input readonly">{{remark}}</view>
    </view>
  </view>

  <view class="muted tip" wx:if="{{isOpening}}">期初欠款不改库存，也不计入销售和毛利。</view>
  <view class="muted tip" wx:elif="{{isPay}}">收款只冲减欠款，不改库存。</view>
  <view class="muted tip" wx:elif="{{isAdjust}}">{{adjustHint}}</view>
  <view class="muted tip" wx:elif="{{editing}}">改数量会同步改库存。记错商品请删除后重新开单。<text wx:if="{{isOut}}">删除销售会去掉本单全部商品。同一张送货单的客户、结算和备注会一起改。</text></view>

  <button wx:if="{{canReturn && !editing}}" class="btn-ghost export-btn" bindtap="goReturn" hidden="{{showCustomerPicker || showSlip}}">退货入库</button>
  <button wx:if="{{isOut && !editing}}" class="btn-ghost export-btn js-export-slip" bindtap="openSlip" hidden="{{showCustomerPicker || showSlip}}">导出送货单</button>
  <button wx:if="{{!editing}}" class="btn-primary save-btn js-edit" bindtap="startEdit" hidden="{{showCustomerPicker || showSlip}}">修改</button>
  <button wx:if="{{editing}}" class="btn-primary save-btn js-save" bindtap="save" hidden="{{showCustomerPicker || showSlip}}">保存</button>
  <button wx:if="{{editing}}" class="btn-ghost cancel-btn js-cancel" bindtap="cancelEdit" hidden="{{showCustomerPicker || showSlip}}">取消</button>
  <button class="btn-danger" bindtap="remove" hidden="{{showCustomerPicker || showSlip}}">删除流水</button>

  <view wx:if="{{showCustomerPicker}}" class="mask" bindtap="closeCustomerPicker">
    <view class="sheet" catchtap="closePickerKeep">
      <view class="sheet-head">
        <view class="sheet-title">选择客户</view>
        <text class="link" catchtap="goAddCustomer">新增</text>
      </view>
      <input class="search" placeholder="搜索客户" value="{{customerKeyword}}" bindinput="onCustomerSearch" />
      <scroll-view scroll-y class="sheet-list">
        <view class="sheet-item" bindtap="clearCustomer">
          <view>
            <view class="item-name">散客</view>
            <view class="muted">不填写客户</view>
          </view>
        </view>
        <view
          class="sheet-item"
          wx:for="{{filteredCustomers}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPickCustomer"
        >
          <view>
            <view class="item-name">{{item.name}}</view>
            <view class="muted">{{item.phone || '未填电话'}} · {{item.address || '未填地址'}}</view>
          </view>
        </view>
        <view wx:if="{{!filteredCustomers.length}}" class="empty">没有匹配客户</view>
      </scroll-view>
    </view>
  </view>

  <include src="/pages/common/slip-overlay.wxml" />
  <canvas type="2d" id="slipCanvas" class="slip-canvas"></canvas>
</view>
