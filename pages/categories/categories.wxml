<view class="page">
  <input
    class="search"
    placeholder="搜索种类 / 商品名"
    value="{{keyword}}"
    bindinput="onSearch"
  />

  <empty wx:if="{{!list.length}}" card title="还没有种类模板" desc="种类只用来带出名称和规格待选项，可改、可删、可再加。不是库存分类。">
    <button class="btn-primary seed-btn" bindtap="goAdd">新增种类</button>
  </empty>

  <view class="card goods-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goEdit">
    <view class="goods-top">
      <view class="item-name">{{item.name}}</view>
      <text class="tag {{item.productKind === 'blank' ? 'tag-blank' : (item.productKind === 'finished' ? 'tag-spec' : 'tag-ok')}}">{{item.kindTag}}</text>
    </view>
    <view class="muted">{{item.summary}}</view>
  </view>

  <fab text="+ 新增" lift bind:press="goAdd" />
</view>
