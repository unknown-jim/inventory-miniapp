<view class="page">
  <input
    class="search"
    placeholder="搜索名称 / 货号 / 条码"
    value="{{keyword}}"
    bindinput="onSearch"
  />

  <view class="toolbar">
    <view class="chip {{onlyAlert ? 'low' : ''}}" bindtap="toggleAlert">
      {{onlyAlert ? '只看预警' : '全部库存'}} · 预警 {{alertCount}}
    </view>
    <text class="link" bindtap="goRecords">流水</text>
  </view>

  <view wx:if="{{!list.length}}" class="card empty">
    <view class="empty-title">没有库存数据</view>
    <view class="muted">新增商品或关掉「只看预警」后再看。</view>
  </view>

  <view class="card stock-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goEdit">
    <view class="stock-top">
      <view class="item-name">{{item.name}}</view>
      <view class="goods-tags">
        <text wx:if="{{item.specTag}}" class="tag {{item.blankProcess ? 'tag-blank' : 'tag-spec'}}">{{item.specTag}}</text>
        <text class="tag {{item.lowStock ? 'tag-alert' : 'tag-ok'}}">{{item.lowStock ? '低于预警' : '正常'}}</text>
      </view>
    </view>
    <view class="muted">货号 {{item.sku || '未填'}} · 预警 ≤ {{item.alertQty}}</view>
    <view wx:if="{{item.skuSummary}}" class="muted">{{item.skuSummary}}</view>
    <view class="bar">
      <view class="bar-fill {{item.lowStock ? 'danger' : ''}}" style="width: {{item.barWidth}}%;"></view>
    </view>
    <view class="stock-nums">
      <text>库存 {{item.stock}}</text>
      <text>进价 ¥{{item.costText}} · 售价 ¥{{item.saleText}}</text>
    </view>
    <view wx:if="{{item.hasSpecs}}" class="link convert-link" catchtap="goConvert" data-id="{{item.id}}">改规格</view>
  </view>
</view>
