.goods-card {
  margin-bottom: 16rpx;
  padding: 24rpx 28rpx 20rpx;
}

.goods-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-name {
  font-size: var(--fs-title);
  font-weight: 600;
}

.price-row {
  margin-top: 16rpx;
  color: var(--c-primary);
  font-size: var(--fs-label);
  font-weight: 600;
}

.price-row.debt {
  margin-top: 8rpx;
  color: var(--c-warn);
}

.warm {
  background: var(--c-warn-soft);
  color: var(--c-warn);
}

.seed-btn {
  margin-top: 24rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  padding: 0 28rpx;
  height: var(--tap-md);
  line-height: var(--tap-md);
  font-size: var(--fs-title);
  background: var(--c-primary);
  color: var(--c-inverse);
  border-radius: var(--radius-round);
  font-weight: 600;
  box-shadow: var(--shadow-raised);
}

.page {
  padding-bottom: 140rpx;
}
