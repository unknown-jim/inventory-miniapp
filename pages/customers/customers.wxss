/* 客户列表。共用类（.page / .card / .search / .muted / .empty / .empty-title /
   .empty-icon / .empty-actions / .btn-primary）来自 app.wxss，这里只写本页布局。
   稿 Screen/09 客户 4:291。 */

/* 稿 row/搜索与新增 7:40：横排 gap 10。与 pages/products 的 .tool-row 同一份写法
   （那一屏右边的 ＋ 就是同一枚稿组件），间距同取 --space-lg。 */
.tool-row {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
  margin-bottom: var(--space-md);
}

/* 全局 .search 自带 margin-bottom，放进 flex 行会把右边的 ＋ 顶偏；
   竖向间距统一交给 .tool-row 的 margin。 */
.tool-row .search {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

/* 稿 btn/新增客户 7:41：44x44 白底、neutral/900 描边的圆，字 18 SemiBold。
   高宽取 --tap-md（96rpx = 48px）与左边 .search 齐平，48 >= 44 地板；
   字号取档位表里离 18px 最近的 --fs-title。逐条与 pages/products 的 .add-btn 相同。 */
.add-btn {
  flex: 0 0 auto;
  width: var(--tap-md);
  height: var(--tap-md);
  line-height: var(--tap-md);
  box-sizing: border-box;
  text-align: center;
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border-brand);
  border-radius: 999rpx;
  color: var(--color-text-primary);
  font-size: var(--fs-title);
  font-weight: 600;
}

/* 稿 sum/客户欠款 13:354：13px Medium、text/primary、行高 44 */
.sum-row {
  min-height: var(--tap-min);
  line-height: var(--tap-min);
  padding: 0 var(--space-xs);
  font-size: var(--fs-label);
  font-weight: 500;
  color: var(--color-text-primary);
}

/* 稿 card/客户列表 4:302：整卡内边距 0，行自己带 12 */
.list-card {
  padding: 0;
  overflow: hidden;
}

/* 稿 row/李老板 4:303 + top 4:304：横排 gap 10、内边距 12，
   行间 1px 分隔线 4:318（border/default）。整行可点，高度 >= --tap-md。 */
.crow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
  min-height: var(--tap-md);
  padding: var(--space-lg);
  border-bottom: 2rpx solid var(--color-border-default);
}

.crow:last-child {
  border-bottom: none;
}

.crow-col {
  flex: 1;
  min-width: 0;
}

/* 稿 name 4:306：16px Medium */
.crow-name {
  font-size: var(--fs-title);
  font-weight: 500;
  color: var(--color-text-primary);
  word-break: break-all;
}

/* 稿 sub 4:307：12px text/muted */
.crow-sub {
  margin-top: 4rpx;
  font-size: var(--fs-caption);
  color: var(--color-text-muted);
  word-break: break-all;
}

/* 稿 amounts 4:308：右对齐一列，行间 gap 2 */
.crow-amounts {
  flex: 0 1 auto;
  text-align: right;
}

.debt-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: var(--space-xs);
}

/* 稿 k 4:310：12px text/muted */
.debt-k {
  font-size: var(--fs-caption);
  color: var(--color-text-muted);
}

/* 稿 v 4:311：14px SemiBold，绑 $7:346 = text/debt。
   欠款红是红的三种语义里的第一种，不要换成 --color-red-600（那是库存预警）。 */
.debt-v {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--color-text-debt);
}

/* 稿 nodebt 4:357：12px text/muted，「无欠款 · 预收 ¥200.00 可抵」 */
.crow-nodebt {
  font-size: var(--fs-caption);
  color: var(--color-text-muted);
}

/* 稿 total 4:312：12px text/muted，右对齐 */
.crow-total {
  margin-top: 4rpx;
  font-size: var(--fs-caption);
  color: var(--color-text-muted);
}

/* 稿 chevron 13:355：16x16，描边绑 $13:6（黑 50%）。两条边 + 旋转 45 度的画法
   与 pages/product-detail 的 .cell-chevron 同源，颜色改绑 --color-text-faint
   （docs/ui-scale.md 的 alpha 黑三档：text/faint 是 50%，对白 3.41:1）。 */
.crow-chevron {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--color-text-faint);
  border-right: 3rpx solid var(--color-text-faint);
  transform: rotate(45deg);
}

/* 空态插画「人形 48」。原样取自 inventory-miniapp-handoffs/spec-1a-assets/empty-icons.wxss
   的 .empty-icon-customers 一条（稿组件 icon/empty/customers 10:32 的 svg 导出，
   几何一个数没动）。几何槽位在 app.wxss 的 .empty-icon 里，这里只补背景图。
   描边色 #0F756E 是稿上的字面量：data URI 里引用不到 CSS 变量。 */
