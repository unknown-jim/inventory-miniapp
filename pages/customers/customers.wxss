.goods-card {
  margin-bottom: 16rpx;
  padding: 24rpx 28rpx 20rpx;
}

.goods-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-name {
  font-size: var(--fs-lg);
  font-weight: 600;
}

.price-row {
  margin-top: 16rpx;
  color: #0F766E;
  font-size: var(--fs-sm);
  font-weight: 600;
}

.price-row.debt {
  margin-top: 8rpx;
  color: #C2410C;
}

.goods-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.mini {
  flex: 1;
  margin: 0;
  height: var(--tap-sm);
  line-height: var(--tap-sm);
}

.warm {
  background: #FFF7ED;
  color: #C2410C;
}

.seed-btn {
  margin-top: 24rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  padding: 0 28rpx;
  height: var(--tap-md);
  line-height: var(--tap-md);
  font-size: var(--fs-lg);
  background: #0F766E;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(15, 118, 110, 0.28);
}

.page {
  padding-bottom: 140rpx;
}
