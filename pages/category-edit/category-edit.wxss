.spec-card {
  margin-top: 16rpx;
}

.spec-title {
  margin-bottom: 8rpx;
  font-weight: 600;
}

.spec-desc {
  margin-bottom: 20rpx;
}

.last-desc {
  margin-bottom: 0;
}

.axis-title {
  margin-bottom: 12rpx;
  min-height: var(--tap-sm);
  line-height: var(--tap-sm);
  font-weight: 600;
  font-size: var(--fs-md);
}

.add-spec {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.add-spec .field-input {
  flex: 1;
}

.spec-add {
  width: 140rpx;
  margin: 0;
  height: var(--tap-md);
  line-height: var(--tap-md);
}

.save-btn {
  margin: 32rpx 0 16rpx;
}
