.spec-card {
  margin-top: 16rpx;
}

.spec-title {
  margin-bottom: 8rpx;
  font-weight: 600;
}

.spec-desc {
  margin-bottom: 20rpx;
}

.last-desc {
  margin-bottom: 0;
}

.axis-title {
  margin-bottom: 12rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-weight: 600;
  font-size: 28rpx;
}

.add-spec {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.add-spec .field-input {
  flex: 1;
}

.spec-add {
  width: 140rpx;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
}

.pay-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.pay-tab {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #F8FAF9;
  border-radius: 14rpx;
  color: #64748B;
  font-size: 28rpx;
}

.kind-tabs .pay-tab {
  font-size: 24rpx;
}

.pay-tab.on {
  background: #0F766E;
  color: #FFFFFF;
  font-weight: 600;
}

.save-btn {
  margin: 32rpx 0 16rpx;
}
