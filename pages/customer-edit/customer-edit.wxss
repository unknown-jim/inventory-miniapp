.tip {
  margin-top: 0;
}

.debt-card {
  margin-top: 16rpx;
}

.debt-num {
  margin: 8rpx 0 12rpx;
  font-size: var(--fs-display);
  font-weight: 700;
  color: var(--c-primary);
}

.debt-num.on {
  color: var(--c-warn);
}

.collect-btn {
  margin-top: 24rpx;
}

.opening-btn {
  margin-top: 16rpx;
}

.list-card {
  padding: 8rpx 28rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--c-line);
}

.list-item:last-child {
  border-bottom: none;
}

.item-name {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.item-right {
  text-align: right;
}

.amount {
  margin-top: 8rpx;
  font-weight: 600;
}

.quiet {
  text-align: center;
  color: var(--c-muted);
}

/* 明细取不到时的「重试」。和 index / products 的 .link 同一套，
   字号不低于 --fs-label，可点高度靠 .quiet 卡片的内边距撑住。 */
.link {
  margin-left: var(--space-xs);
  color: var(--c-primary);
  font-size: var(--fs-label);
}

.save-btn {
  margin: 32rpx 0 16rpx;
}

/* 往来明细触底不触发时的手动兜底。高度用共用 .btn-ghost（--tap-md），
   这里只管间距。 */
.ledger-more {
  margin: var(--space-md) 0;
}

.call-btn {
  margin-bottom: 16rpx;
}

.sheet-title {
  font-size: var(--fs-title);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.pay-hint {
  margin-bottom: 24rpx;
}
