/* 客户编辑 / 新增。共用类（.page / .card / .field / .field-label / .field-input /
   .field-textarea / .btn-primary / .btn-primary[disabled] / .btn-danger）
   来自 app.wxss，这里只写本页布局。稿 Screen/09b 客户编辑 4:1116。 */

/* 共用 .field 自带下外边距，卡里最后一格不要那一截 */
.last {
  margin-bottom: 0;
}

/* 稿 card/危险区 4:1133：白卡 r12、内边距 16、行间 gap 10 */
.danger-card {
  margin-top: var(--gap);
}

/* 稿 4:1134「删除客户·禁用（有往来记录）」：14px、neutral/600、**不透明**。
   禁用一律 opacity: 1（docs/ui-scale.md「禁用态一律不用透明度」）；
   这一档没有实底，是纯文字档，所以只降字色、不加灰底。 */
.danger-off {
  display: flex;
  align-items: center;
  min-height: var(--tap-min);
  font-size: var(--fs-body);
  color: var(--color-neutral-600);
  opacity: 1;
}

/* 稿 note 4:1135：12px neutral/500 */
.danger-note {
  margin-top: var(--space-xs);
  font-size: var(--fs-caption);
  color: var(--color-neutral-500);
  line-height: 1.5;
}

/* 底栏占位：高度 = 按钮 104 + 上内边距 12 + 下内边距 24 + 安全区 */
.cta-hold {
  height: calc(env(safe-area-inset-bottom) + 160rpx);
}

/* 稿 bottom-cta 4:1136：1px hairline（做成 border-top）+ 安全区 34 */
.cta-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  background: var(--color-bg-card);
  border-top: 2rpx solid var(--color-border-default);
}

.cta-inner {
  padding: var(--space-sm) var(--page-pad) calc(env(safe-area-inset-bottom) + var(--space-lg));
}
