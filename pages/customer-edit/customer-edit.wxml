<view class="page">
  <view class="card">
    <field label="客户名称">
      <input class="field-input" data-field="name" value="{{name}}" bindinput="onField" placeholder="例如 张三超市" hidden="{{showPay || showOpening}}" />
    </field>
    <field label="电话">
      <input class="field-input" data-field="phone" value="{{phone}}" bindinput="onField" placeholder="可选" hidden="{{showPay || showOpening}}" />
    </field>
    <field label="送货地址">
      <textarea
        class="field-input field-textarea"
        data-field="address"
        value="{{address}}"
        bindinput="onField"
        placeholder="可选"
        maxlength="200"
        auto-height
        hidden="{{showPay || showOpening}}"
      />
    </field>
    <field label="内部备注" last="{{isEdit}}">
      <input class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="仅自己可见" hidden="{{showPay || showOpening}}" />
    </field>
    <field label="上线前欠款" last wx:if="{{!isEdit}}">
      <input class="field-input" type="digit" data-field="openingAmount" value="{{openingAmount}}" bindinput="onField" placeholder="没有就留空" />
    </field>
    <view class="muted tip">内部备注不会出现在送货单上。<text wx:if="{{!isEdit}}">上线前欠款只记应收，不改库存、不计入销售。</text></view>
  </view>

  <block wx:if="{{isEdit}}">
    <view class="card debt-card">
      <view class="muted">当前欠款</view>
      <amount class="debt-num {{hasDebt ? 'on' : ''}}" role="display" text="{{receivableText}}" />
      <view class="muted">累计销售 {{saleCount}} 笔 · ¥{{saleAmountText}}</view>
      <button wx:if="{{hasDebt}}" class="btn-primary collect-btn js-pay-open" bindtap="openPay" hidden="{{showPay || showOpening}}">收款</button>
      <button class="btn-ghost opening-btn js-opening" bindtap="openOpening" hidden="{{showPay || showOpening}}">记期初欠款</button>
    </view>

    <view class="section-title">
      <text>往来记录</text>
    </view>
    <view wx:if="{{ledger.length}}" class="card list-card">
      <cell class="cell-row" wx:for="{{ledger}}" wx:key="id" data-id="{{item.id}}" bindtap="goRecord">
        <view slot="main">
          <view class="item-name">{{item.productName}}</view>
          <view class="muted">{{item.timeText}}<text wx:if="{{item.isOut}}"> · {{item.qtyText}} 件</text><text wx:if="{{item.isMulti}}"> · {{item.lineCount}} 种</text></view>
        </view>
        <view slot="side">
          <text class="tag {{item.tagClass}}">{{item.typeText}}</text>
          <amount role="row" text="{{item.amountText}}" />
        </view>
      </cell>
    </view>
    <view wx:elif="{{ledgerUnavailable}}" class="card quiet">往来明细没取到。上面的欠款和累计销售来自服务端，是准的。<text class="link" bindtap="retryLedger">重试</text></view>
    <view wx:elif="{{ledgerLoading}}" class="card quiet">正在加载…</view>
    <view wx:else class="card quiet">还没有往来记录</view>
    <button wx:if="{{ledger.length && ledgerHasMore && !ledgerLoading}}" class="btn-ghost ledger-more js-ledger-more" bindtap="onLoadMoreLedger">加载更多</button>
    <view wx:if="{{ledger.length && ledgerLoading}}" class="card quiet">正在加载…</view>
    <view wx:elif="{{ledger.length && !ledgerHasMore}}" class="card quiet">没有更多了</view>
  </block>

  <button class="btn-primary save-btn" bindtap="save" hidden="{{showPay || showOpening}}">保存</button>
  <button wx:if="{{isEdit && phone}}" class="btn-ghost call-btn" bindtap="callPhone" hidden="{{showPay || showOpening}}">拨打电话</button>
  <button wx:if="{{isEdit}}" class="btn-danger" bindtap="remove" hidden="{{showPay || showOpening}}">删除客户</button>

  <sheet wx:if="{{showPay}}" class="js-pay-sheet" pad-bottom="{{48}}" lift bind:close="closePay">
    <view class="sheet-title">收款</view>
    <view class="muted pay-hint">当前欠款 ¥{{receivableText}}，不能超过这个金额。</view>
    <field label="本次收款">
      <input class="field-input" type="digit" data-field="payAmount" value="{{payAmount}}" bindinput="onField" placeholder="0.00" />
    </field>
    <field label="备注">
      <input class="field-input" data-field="payRemark" value="{{payRemark}}" bindinput="onField" placeholder="可选" />
    </field>
    <button class="btn-primary js-pay-submit" bindtap="submitPay">确认收款</button>
  </sheet>

  <sheet wx:if="{{showOpening}}" class="js-opening-sheet" pad-bottom="{{48}}" lift bind:close="closeOpening">
    <view class="sheet-title">期初欠款</view>
    <view class="muted pay-hint">使用本程序前已经欠的钱。只加欠款，不改库存、不计入销售。</view>
    <field label="欠款金额">
      <input class="field-input js-opening-amount" type="digit" data-field="openingAmount" value="{{openingAmount}}" bindinput="onField" placeholder="0.00" />
    </field>
    <field label="备注">
      <input class="field-input" data-field="openingRemark" value="{{openingRemark}}" bindinput="onField" placeholder="例如 上线前旧账" />
    </field>
    <button class="btn-primary js-opening-submit" bindtap="submitOpening">确认记账</button>
  </sheet>
</view>
