<!-- 客户编辑 / 新增。稿 Screen/09b 客户编辑 4:1116（content 4:1119、bottom-cta 4:1136）、
     变体/名称空底栏 13:395、edit-caption 9:56 逐字：
     「保存走底部 CTA，不放页头右上（胶囊位）；有往来记录的客户不可删，
       置为不可点并说明原因，不要点了才报错」。
     三个入口：客户列表右上角 ＋（无参 = 新增）、销售 / 流水详情的「＋ 新增客户」
     （?select=1，存完回选）、客户详情的「编辑客户资料」（?id=）。 -->
<view class="page">
  <!-- 稿 card/基础信息 4:1120：四组「label + 输入框」，label 13px neutral/500 -->
  <view class="card">
    <view class="field">
      <view class="field-label">客户名称 · 必填</view>
      <input
        class="field-input js-edit-name"
        data-field="name"
        value="{{name}}"
        bindinput="onField"
        placeholder="例如 张三超市"
      />
    </view>
    <view class="field">
      <view class="field-label">电话</view>
      <input
        class="field-input"
        data-field="phone"
        value="{{phone}}"
        bindinput="onField"
        placeholder="选填"
      />
    </view>
    <view class="field">
      <view class="field-label">地址</view>
      <textarea
        class="field-input field-textarea"
        data-field="address"
        value="{{address}}"
        bindinput="onField"
        placeholder="选填"
        maxlength="200"
        auto-height
      />
    </view>
    <!-- 稿 l4 4:1130 与 ph/备注 13:404 逐字 -->
    <view class="field last">
      <view class="field-label">内部备注（客户看不到）</view>
      <input
        class="field-input"
        data-field="remark"
        value="{{remark}}"
        bindinput="onField"
        placeholder="选填，仅店内可见"
      />
    </view>
  </view>

  <!-- 稿 card/危险区 4:1133。稿上只画了**禁用**那一档（有往来记录）：
       14px neutral/600 的文字 + 12px neutral/500 的说明。
       可删那一档稿上没画，按 docs/ui-scale.md「破坏性动作用 danger 视觉」
       走共用类 .btn-danger（与「移出成员」同一级，见规格 §6-7）。 -->
  <view wx:if="{{isEdit}}" class="card danger-card">
    <block wx:if="{{canDelete}}">
      <button class="btn-danger js-edit-delete" bindtap="remove">删除客户</button>
      <view class="danger-note">这个客户从没记过账，删掉不影响任何流水。</view>
    </block>
    <block wx:else>
      <view class="danger-off js-edit-delete-off">删除客户</view>
      <view class="danger-note">{{deleteNote}}</view>
    </block>
  </view>

  <!-- 底栏是 fixed，正常文档流要留出等高的空白，否则最后一块内容会被盖住 -->
  <view class="cta-hold"></view>

  <!-- 稿 bottom-cta 4:1136：hairline + 一枚保存 + 安全区。
       名称为空时走稿 13:401 的 btn/保存·disabled，
       正好是共用类 .btn-primary[disabled]（neutral/100 底 + neutral/500 字、opacity 1）。 -->
  <view class="cta-bar">
    <view class="cta-inner">
      <button
        class="btn-primary js-edit-save"
        bindtap="save"
        disabled="{{!canSave || saving}}"
      >保存</button>
    </view>
  </view>
</view>
