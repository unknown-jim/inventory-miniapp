<view class="page">
  <view class="card">
    <view class="field">
      <view class="field-label">商品</view>
      <view class="field-input picker" bindtap="openPicker">{{productName}}</view>
    </view>
    <view class="muted tip" wx:if="{{blankProcess}}">只能改成衣现货，不能改白坯。要做成衣请直接销售。</view>
    <view class="muted tip" wx:elif="{{hasSpecs}}">从仓里的现货改到另一个颜色 / 尺码，一件还是一件。</view>

    <view class="spec-block" wx:if="{{hasSpecs}}">
      <view class="field">
        <view class="field-label">从</view>
        <view class="chips">
          <view
            class="chip {{item.on ? 'on' : ''}}"
            wx:for="{{fromOptions}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="pickFrom"
          >{{item.specText}} {{item.stock}}</view>
        </view>
        <view class="muted" wx:if="{{!fromOptions.length}}">没有现货可改</view>
      </view>
      <view class="field">
        <view class="field-label">改成颜色</view>
        <view class="chips">
          <view
            class="chip {{item.on ? 'on' : ''}}"
            wx:for="{{colorOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="pickToColor"
          >{{item.value}}</view>
        </view>
      </view>
      <view class="field">
        <view class="field-label">改成尺码</view>
        <view class="chips">
          <view
            class="chip {{item.on ? 'on' : ''}}"
            wx:for="{{sizeOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="pickToSize"
          >{{item.value}}</view>
        </view>
      </view>
    </view>

    <view class="field-row">
      <view class="field half">
        <view class="field-label">数量</view>
        <input class="field-input" type="digit" data-field="qty" value="{{qty}}" bindinput="onField" placeholder="0" hidden="{{showPicker}}" />
      </view>
      <view class="field half last">
        <view class="field-label">备注</view>
        <input class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="可选" hidden="{{showPicker}}" />
      </view>
    </view>
  </view>

  <button class="btn-primary save-btn" bindtap="submit" hidden="{{showPicker}}">确认改规格</button>

  <view wx:if="{{showPicker}}" class="mask" bindtap="closePicker">
    <view class="sheet" catchtap="closePickerKeep">
      <view class="sheet-title">选择商品</view>
      <input class="search" placeholder="搜索商品" value="{{keyword}}" bindinput="onSearch" />
      <scroll-view scroll-y class="sheet-list">
        <view
          class="sheet-item"
          wx:for="{{filtered}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPick"
        >
          <view>
            <view class="item-name">{{item.name}}</view>
            <view class="muted">
              <block wx:if="{{item.blankProcess}}">白坯加工 · </block>
              <block wx:elif="{{item.hasSpecs}}">成衣现货 · </block>库存 {{item.stock}}
            </view>
          </view>
        </view>
        <view wx:if="{{!filtered.length}}" class="empty">没有带颜色尺码的商品</view>
      </scroll-view>
    </view>
  </view>
</view>
