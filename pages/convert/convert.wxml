<view class="page">
  <view class="card">
    <field label="商品" mode="picker" value="{{productName}}" bindtap="openPicker" />
    <view class="muted tip" wx:if="{{blankProcess}}">只能改分规格现货，不能改待加工库存。要加工请直接销售。</view>
    <view class="muted tip" wx:elif="{{hasSpecs}}">从仓里的现货改到另一格，一件还是一件。</view>

    <view class="spec-block" wx:if="{{hasSpecs}}">
      <field label="从" dense>
        <view class="chips">
          <view
            class="chip {{item.on ? 'on' : ''}}"
            wx:for="{{fromOptions}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="pickFrom"
          >{{item.specText}} {{item.stock}}</view>
        </view>
        <view class="muted" wx:if="{{!fromOptions.length}}">没有现货可改</view>
      </field>
      <field label="改成{{specAxis1}}" dense wx:if="{{colors.length}}">
        <view class="chips">
          <view
            class="chip {{item.on ? 'on' : ''}}"
            wx:for="{{colorOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="pickToColor"
          >{{item.value}}</view>
        </view>
      </field>
      <field label="改成{{specAxis2}}" dense wx:if="{{sizes.length}}">
        <view class="chips">
          <view
            class="chip {{item.on ? 'on' : ''}}"
            wx:for="{{sizeOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="pickToSize"
          >{{item.value}}</view>
        </view>
      </field>
    </view>

    <view class="field-row">
      <field label="数量" class="half">
        <input class="field-input" type="digit" data-field="qty" value="{{qty}}" bindinput="onField" placeholder="0" hidden="{{showPicker}}" />
      </field>
      <field label="备注" class="half" last>
        <input class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="可选" hidden="{{showPicker}}" />
      </field>
    </view>
  </view>

  <button class="btn-primary save-btn" bindtap="submit" hidden="{{showPicker}}">确认改规格</button>

  <sheet wx:if="{{showPicker}}" lift bind:close="closePicker">
    <view class="sheet-title">选择商品</view>
    <input class="search" placeholder="搜索商品" value="{{keyword}}" bindinput="onSearch" />
    <scroll-view scroll-y class="sheet-list">
      <view
        class="sheet-item"
        wx:for="{{filtered}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onPick"
      >
        <view>
          <view class="item-name">{{item.name}}</view>
          <view class="muted">
            <block wx:if="{{item.specTag}}">{{item.specTag}} · </block>库存 {{item.stock}}
          </view>
        </view>
      </view>
      <empty wx:if="{{!filtered.length}}" desc="没有带规格的商品" />
    </scroll-view>
  </sheet>
</view>
