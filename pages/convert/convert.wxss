.field-row {
  display: flex;
  gap: 16rpx;
}

.half {
  flex: 1;
}

.last {
  margin-bottom: 0;
}

.picker {
  line-height: var(--tap-md);
}

.tip {
  margin: 0 0 24rpx;
}

.save-btn {
  margin: 32rpx 0 16rpx;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 24rpx 12rpx;
}

.sheet-title {
  font-size: var(--fs-lg);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.sheet-list {
  height: 560rpx;
}

.sheet-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}

.item-name {
  font-weight: 600;
  margin-bottom: 6rpx;
}
