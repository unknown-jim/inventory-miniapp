.last {
  margin-bottom: 0;
}

.picker {
  line-height: var(--tap-md);
}

.tip {
  margin: 0 0 24rpx;
}

.save-btn {
  margin: 32rpx 0 16rpx;
}

.sheet-title {
  font-size: var(--fs-title);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.sheet-list {
  height: 560rpx;
}

.sheet-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--c-line);
}

.item-name {
  font-weight: 600;
  margin-bottom: 6rpx;
}
