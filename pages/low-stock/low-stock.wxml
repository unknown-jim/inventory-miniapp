<view class="page">
  <block wx:if="{{pageLoading}}">
    <page-loading />
  </block>

  <!-- 稿 state/error 3:759（可重试：标题 + 一句话 + 一枚 primary）与
       state/error/blocking（不可重试）4:1041。标题和正文由 store.readyOrFailure()
       给，**不在这里写死**：「被移出店铺」和「网络断了」不是同一句话，
       而这一支两种都要落。 -->
  <view wx:elif="{{loadErrorText}}" class="card empty js-load-error">
    <view class="empty-title js-load-error-title">{{loadErrorTitle}}</view>
    <view class="muted js-load-error-text">{{loadErrorText}}</view>
    <view wx:if="{{loadErrorRetry}}" class="empty-actions">
      <button class="btn-primary js-load-error-retry" bindtap="reload">重试</button>
    </view>
  </view>

  <block wx:else>
    <!-- 稿 Screen/01b 7:274：「共 3 种低于预警线 · 点行进商品详情」 -->
    <view class="summary js-low-stock-summary">{{summaryText}}</view>

    <view wx:if="{{rows.length}}" class="card list-card">
      <view
        class="restock-row js-restock-row"
        hover-class="press"
        wx:for="{{rows}}"
        wx:key="key"
        data-id="{{item.productId}}"
        bindtap="goDetail"
      >
        <view class="restock-name">{{item.name}}</view>
        <view class="restock-qty">
          <text class="restock-remain">{{item.remainText}}</text>
          <text class="restock-threshold">{{item.thresholdText}}</text>
        </view>
        <view class="restock-chevron">›</view>
      </view>
    </view>

    <!-- 稿上没画这一屏的空态（看板无预警时入口本身就不出现，进不来）。
         这是防御位：真进来了要说人话，不要留白屏。 -->
    <view wx:else class="card empty">
      <view class="empty-title">暂时不用补货</view>
      <view class="muted">所有商品的库存都在预警线以上。</view>
    </view>
  </block>
</view>
