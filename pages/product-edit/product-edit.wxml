<view class="page">
  <view class="card">
    <view class="card-title">基础信息</view>

    <view class="field">
      <view class="field-label">商品名称</view>
      <input class="field-input js-pe-name" data-field="name" value="{{name}}" bindinput="onField" placeholder="请输入商品名称" />
      <view class="chips name-chips" wx:if="{{nameSuggest.length}}">
        <view class="chip js-pe-name-suggest" wx:for="{{nameSuggest}}" wx:key="*this" data-value="{{item}}" bindtap="pickName">{{item}}</view>
      </view>
    </view>

    <view class="field-row">
      <view class="field half">
        <view class="field-label">货号</view>
        <input class="field-input" data-field="sku" value="{{sku}}" bindinput="onField" placeholder="可选" />
      </view>
      <view class="field half">
        <view class="field-label">条码</view>
        <input class="field-input" data-field="barcode" value="{{barcode}}" bindinput="onField" placeholder="可选" />
      </view>
    </view>

    <view class="field-row">
      <view class="field half">
        <view class="field-label">默认售价（元）</view>
        <input
          class="field-input js-pe-sale {{focusPrice ? 'input-focus' : ''}}"
          type="digit"
          data-field="salePrice"
          value="{{salePrice}}"
          focus="{{focusPrice}}"
          bindinput="onField"
          bindblur="onPriceBlur"
          placeholder="0.00"
        />
      </view>
      <view class="field half">
        <view class="field-label">默认进价（元）</view>
        <input class="field-input js-pe-cost" type="digit" data-field="costPrice" value="{{costPrice}}" bindinput="onField" placeholder="0.00" />
      </view>
    </view>

    <view class="field-row" wx:if="{{!hasSpecs && isEdit}}">
      <view class="field half">
        <view class="field-label">当前库存</view>
        <view class="field-input readonly js-pe-stock">{{stockText}}</view>
      </view>
      <view class="field half">
        <view class="field-label">库存预警（件）</view>
        <input class="field-input js-pe-alert" type="digit" data-field="alertQty" value="{{alertQty}}" bindinput="onField" placeholder="5" />
      </view>
    </view>
    <view class="field" wx:elif="{{!hasSpecs}}">
      <view class="field-label">库存预警（件）</view>
      <input class="field-input js-pe-alert" type="digit" data-field="alertQty" value="{{alertQty}}" bindinput="onField" placeholder="5" />
    </view>

    <view class="field" wx:if="{{showImage}}">
      <view class="field-label">商品图片</view>
      <view class="image-add" wx:if="{{!image}}" bindtap="pickImage">＋ 添加图片</view>
      <view class="image-box" wx:else>
        <image class="image-preview" src="{{image}}" mode="aspectFill" binderror="onImageError" />
        <view class="image-ops">
          <text class="image-link" bindtap="pickImage">换图</text>
          <text class="image-link danger" bindtap="removeImage">删除</text>
        </view>
      </view>
      <view class="field-hint">仅本店成员可见，用于快速认货</view>
    </view>

    <view class="muted margin-line">单件毛利 ¥{{marginText}} · 毛利率 {{rateText}}</view>
  </view>

  <view class="card fold-card">
    <view class="fold-row js-pe-fold-spec" data-key="spec" bindtap="toggleFold">
      <text class="fold-label">规格 · {{specSummary}}</text>
      <view class="fold-chevron {{specOpen ? 'open' : ''}}"></view>
    </view>
    <view class="fold-row js-pe-fold-blank" data-key="blank" bindtap="toggleFold">
      <text class="fold-label">半成品池 · {{blankSummary}}</text>
      <view class="fold-chevron {{blankOpen ? 'open' : ''}}"></view>
    </view>
    <view class="fold-row js-pe-fold-sku" data-key="sku" bindtap="toggleFold">
      <text class="fold-label">每个规格的库存与价格 · {{skuSummary}}</text>
      <view class="fold-chevron {{skuOpen ? 'open' : ''}}"></view>
    </view>
  </view>

  <view class="card sub-card" id="pe-spec-card" wx:if="{{specOpen}}">
    <view class="card-title">规格（可选，最多两项）</view>

    <view class="field">
      <view class="field-label">种类模板</view>
      <view class="chips" wx:if="{{categories.length}}">
        <view
          class="chip js-pe-category {{item.on ? 'on' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="applyCategory"
        >{{item.name}}</view>
      </view>
      <view class="muted" wx:else>还没有种类模板。点下面的「管理模板」添加，建档时就能带出名称和规格。</view>
    </view>

    <view class="axis-row">
      <text class="axis-label">规格一</text>
      <input class="axis-input js-pe-axis1" data-field="specAxis1" value="{{specAxis1}}" bindinput="onField" placeholder="如 颜色、口味" />
    </view>
    <view class="chips">
      <view class="chip chip-val js-pe-color-chip" wx:for="{{colors}}" wx:key="*this">
        <text class="chip-text">{{item}}</text>
        <view class="chip-del js-pe-color-del" data-value="{{item}}" catchtap="removeColor">×</view>
      </view>
      <input
        wx:if="{{adding === 'color'}}"
        class="chip-input js-pe-spec-input"
        value="{{specInput}}"
        focus="{{true}}"
        data-field="specInput"
        bindinput="onField"
        bindconfirm="commitSpec"
        bindblur="commitSpec"
        placeholder="输入取值"
      />
      <view wx:else class="chip add js-pe-color-add" data-axis="color" bindtap="startAdd">＋ 添加规格值</view>
    </view>

    <view class="axis-row">
      <text class="axis-label">规格二</text>
      <input class="axis-input js-pe-axis2" data-field="specAxis2" value="{{specAxis2}}" bindinput="onField" placeholder="如 尺码、容量（可空）" />
    </view>
    <view class="chips last-chips">
      <view class="chip chip-val js-pe-size-chip" wx:for="{{sizes}}" wx:key="*this">
        <text class="chip-text">{{item}}</text>
        <view class="chip-del js-pe-size-del" data-value="{{item}}" catchtap="removeSize">×</view>
      </view>
      <input
        wx:if="{{adding === 'size'}}"
        class="chip-input js-pe-spec-input"
        value="{{specInput}}"
        focus="{{true}}"
        data-field="specInput"
        bindinput="onField"
        bindconfirm="commitSpec"
        bindblur="commitSpec"
        placeholder="输入取值"
      />
      <view wx:else class="chip add js-pe-size-add" data-axis="size" bindtap="startAdd">＋ 添加规格值</view>
    </view>

    <view class="link-row js-pe-categories" bindtap="goCategories">
      <text class="link-label">管理模板</text>
      <view class="fold-chevron"></view>
    </view>
  </view>

  <view class="card sub-card" wx:if="{{blankOpen}}">
    <view class="blank-head">
      <view class="blank-icon"></view>
      <text class="card-title blank-title">半成品池</text>
      <view class="switch-hit js-pe-blank-switch" bindtap="toggleBlankPool">
        <view class="switch {{blankPool ? 'on' : ''}}">
          <view class="switch-knob"></view>
        </view>
      </view>
    </view>
    <block wx:if="{{blankPool}}">
      <view class="blank-stats">
        <view class="blank-stat">
          <view class="field-label">半成品库存</view>
          <view class="blank-readonly js-pe-blank-stock">{{blankStockText}} 件</view>
        </view>
        <view class="blank-stat">
          <view class="field-label">预警线</view>
          <input class="blank-input js-pe-blank-alert" type="digit" data-field="alertQty" value="{{alertQty}}" bindinput="onField" placeholder="5" />
        </view>
      </view>
      <view class="blank-note">1 件半成品 = 1 件成品；现货不足时自动从这里扣，整单共享</view>
    </block>
    <view class="muted" wx:else>打开后这件商品多一格未分规格的库存：进货只进这一格，销售时现货不够会自动从这里扣。要先添加规格取值才能打开。</view>
  </view>

  <view class="card sub-card" wx:if="{{skuOpen}}">
    <view class="card-title">每个规格的库存与价格</view>
    <block wx:if="{{skuRows.length}}">
      <view class="sku-head">
        <text class="sku-c1">规格</text>
        <text class="sku-c2">库存</text>
        <text class="sku-c3" wx:if="{{!blankPool}}">预警</text>
        <text class="sku-c4">售价</text>
      </view>
      <view class="sku-row js-pe-sku-row" wx:for="{{skuRows}}" wx:key="key">
        <text class="sku-c1 js-pe-sku-title">{{item.specText}}</text>
        <text class="sku-c2 sku-readonly js-pe-sku-stock">{{item.stock}}</text>
        <input
          wx:if="{{!blankPool}}"
          class="sku-c3 sku-input js-pe-sku-alert"
          type="digit"
          data-index="{{index}}"
          data-field="alertQty"
          value="{{item.alertQty}}"
          bindinput="onSkuField"
          placeholder="5"
        />
        <input
          class="sku-c4 sku-input js-pe-sku-price"
          type="digit"
          data-index="{{index}}"
          data-field="salePrice"
          value="{{item.salePrice}}"
          bindinput="onSkuField"
          placeholder="0.00"
        />
      </view>
      <view class="muted sku-note" wx:if="{{blankPool}}">件数只读，改数走商品详情的「库存修正」门。半成品商品的预警看半成品池那一格。</view>
      <view class="muted sku-note" wx:else>件数只读，改数走商品详情的「库存修正」门。</view>
    </block>
    <view class="muted" wx:else>先在「规格」里添加取值，这里会自动列出每一格。</view>
  </view>

  <view class="danger-link js-pe-remove" wx:if="{{isEdit}}" bindtap="remove">删除商品</view>

  <canvas type="2d" id="imageCanvas" class="image-canvas"></canvas>

  <view class="save-bar">
    <button class="btn-primary save-btn js-pe-save" disabled="{{saving}}" bindtap="save">{{saving ? '保存中…' : '保存'}}</button>
  </view>
</view>
