.field-row {
  display: flex;
  gap: 16rpx;
}

.half {
  flex: 1;
}

.margin-box {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 18rpx 20rpx;
  background: #ECFDF5;
  color: #0F766E;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.readonly {
  line-height: 80rpx;
  color: #64748B;
}

.last {
  margin-bottom: 0;
}

.save-btn {
  margin: 32rpx 0 16rpx;
}

.spec-card {
  margin-top: 16rpx;
}

.spec-title {
  margin-bottom: 8rpx;
  font-weight: 600;
}

.spec-desc {
  margin-bottom: 20rpx;
}

.add-spec {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.add-spec .field-input {
  flex: 1;
}

.spec-add {
  width: 140rpx;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
}

.pay-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.pay-tab {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #F8FAF9;
  border-radius: 14rpx;
  color: #64748B;
  font-size: 28rpx;
}

.pay-tab.on {
  background: #0F766E;
  color: #FFFFFF;
  font-weight: 600;
}

.sku-card {
  padding: 20rpx 0;
  border-top: 1rpx solid #F1F5F4;
}

.sku-card:first-of-type {
  border-top: none;
  padding-top: 0;
}

.sku-title {
  margin-bottom: 16rpx;
  font-weight: 600;
}
