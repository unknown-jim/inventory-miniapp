.margin-box {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 18rpx 20rpx;
  background: #ECFDF5;
  color: #0F766E;
  border-radius: 12rpx;
  font-size: var(--fs-sm);
  font-weight: 600;
}

.readonly {
  line-height: var(--tap-md);
  color: #64748B;
}

.last {
  margin-bottom: 0;
}

.save-btn {
  margin: 32rpx 0 16rpx;
}

.spec-card {
  margin-top: 16rpx;
}

.spec-title {
  margin-bottom: 8rpx;
  font-weight: 600;
}

.spec-desc {
  margin-bottom: 20rpx;
}

.field.last + .spec-desc {
  margin-top: 12rpx;
  margin-bottom: 0;
}

.axis-title {
  margin-bottom: 12rpx;
  min-height: var(--tap-sm);
  line-height: var(--tap-sm);
  font-weight: 600;
  font-size: var(--fs-md);
}

.add-spec {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.add-spec .field-input {
  flex: 1;
}

.spec-add {
  width: 140rpx;
  margin: 0;
  height: var(--tap-md);
  line-height: var(--tap-md);
}

.field-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.field-head .field-label {
  margin-bottom: 0;
}

.link {
  color: #0F766E;
  font-size: var(--fs-sm);
}

.name-chips {
  margin-top: 12rpx;
  margin-bottom: 0;
}

.sku-card {
  padding: 20rpx 0;
  border-top: 1rpx solid #F1F5F4;
}

.sku-card:first-of-type {
  border-top: none;
  padding-top: 0;
}

.sku-title {
  margin-bottom: 16rpx;
  font-weight: 600;
}
