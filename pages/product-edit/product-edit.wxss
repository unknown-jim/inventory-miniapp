.margin-box {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 18rpx 20rpx;
  background: #ECFDF5;
  color: #0F766E;
  border-radius: 12rpx;
  font-size: var(--fs-sm);
  font-weight: 600;
}

.readonly {
  line-height: var(--tap-md);
  color: #64748B;
}

.last {
  margin-bottom: 0;
}

.save-btn {
  margin: 32rpx 0 16rpx;
}

.spec-card {
  margin-top: 16rpx;
}

.spec-title {
  margin-bottom: 8rpx;
  font-weight: 600;
}

.spec-desc {
  margin-bottom: 20rpx;
}

.field.last + .spec-desc {
  margin-top: 12rpx;
  margin-bottom: 0;
}

.axis-title {
  margin-bottom: 12rpx;
  min-height: var(--tap-sm);
  line-height: var(--tap-sm);
  font-weight: 600;
  font-size: var(--fs-md);
}

.add-spec {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.add-spec .field-input {
  flex: 1;
}

.spec-add {
  width: 140rpx;
  margin: 0;
  height: var(--tap-md);
  line-height: var(--tap-md);
}

.field-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.field-head .field-label {
  margin-bottom: 0;
}

.link {
  color: #0F766E;
  font-size: var(--fs-sm);
}

.name-chips {
  margin-bottom: 0;
}

.sku-card {
  padding: 20rpx 0;
  border-top: 1rpx solid #F1F5F4;
}

.sku-card:first-of-type {
  border-top: none;
  padding-top: 0;
}

.sku-title {
  margin-bottom: 16rpx;
  font-weight: 600;
}

/* 隐藏压缩画布：canvas 实际像素由 node.width/height 决定，CSS 尺寸只是占位。 */
.image-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 600px;
  height: 600px;
  pointer-events: none;
}

.image-add {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--tap-lg);
  border: 2rpx dashed #CBD5E1;
  border-radius: 12rpx;
  color: #64748B;
  font-size: var(--fs-sm);
}

.image-box {
  display: flex;
  align-items: center;
  gap: var(--gap);
}

.image-preview {
  width: 112rpx;
  height: 112rpx;
  border-radius: 8rpx;
  background: #F1F5F4;
}

.image-ops {
  display: flex;
  gap: var(--gap);
}

.danger {
  color: #DC2626;
}
