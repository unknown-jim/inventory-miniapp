<view class="page">
  <view class="card stat-grid">
    <view class="stat">
      <view class="muted">进货金额</view>
      <amount class="stat-num" role="stat" text="{{purchaseAmount}}" />
    </view>
    <view class="stat">
      <view class="muted">销售金额</view>
      <amount class="stat-num warm" role="stat" text="{{salesAmount}}" />
    </view>
    <view class="stat">
      <view class="muted">销售毛利</view>
      <amount class="stat-num" role="stat" text="{{profit}}" />
    </view>
    <view class="stat">
      <view class="muted">客户欠款</view>
      <amount class="stat-num warm" role="stat" text="{{receivable}}" />
    </view>
  </view>

  <view wx:if="{{aggregatesStale}}" class="card quiet js-aggregates-stale">这里的汇总金额正在核对，可能不准；单张单据上的金额是准的。请把这个情况告诉店主。</view>

  <view class="chips">
    <view class="chip {{type === 'all' ? 'on' : ''}}" data-type="all" bindtap="setType">全部 {{count}}</view>
    <view class="chip {{type === 'in' ? 'on' : ''}}" data-type="in" bindtap="setType">进货</view>
    <view class="chip {{type === 'out' ? 'on' : ''}}" data-type="out" bindtap="setType">销售</view>
    <view class="chip {{type === 'pay' ? 'on' : ''}}" data-type="pay" bindtap="setType">收款</view>
    <view class="chip {{type === 'return' ? 'on' : ''}}" data-type="return" bindtap="setType">退货</view>
    <view class="chip {{type === 'convert' ? 'on' : ''}}" data-type="convert" bindtap="setType">改规格</view>
    <view class="chip {{type === 'adjust' ? 'on' : ''}}" data-type="adjust" bindtap="setType">调整</view>
  </view>

  <empty wx:if="{{loaded && !list.length}}" card desc="还没有流水" />

  <view class="card list-card" wx:if="{{list.length}}">
    <cell class="cell-row js-record-item {{item.isOut ? 'js-record-out' : ''}}" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onRecordTap">
      <view slot="main">
        <view class="item-name">{{item.productName}}</view>
        <view class="muted" wx:if="{{item.hasSpec}}">{{item.specText}}</view>
        <view class="muted">
          {{item.timeText}}
          <block wx:if="{{item.isOut || item.isIn || item.isAdjust}}"> · {{item.qtyText}} 件<block wx:if="{{item.isMulti}}"> · {{item.lineCount}} 种</block><block wx:elif="{{!item.isAdjust}}"> · 单价 ¥{{item.priceText}}</block></block>
        </view>
        <view wx:if="{{item.customerText}}" class="muted">客户 {{item.customerText}}</view>
        <view wx:if="{{item.isOut && item.hasDebt}}" class="muted">已收 ¥{{item.paidText}} · 欠 ¥{{item.debtText}}</view>
        <view wx:if="{{item.remark}}" class="muted">{{item.remark}}</view>
      </view>
      <view slot="side">
        <text class="tag {{item.tagClass}}">{{item.typeText}}</text>
        <amount wx:if="{{!item.isAdjust}}" role="row" text="{{item.amountText}}" />
          <view wx:if="{{item.isOut}}" class="muted">毛利 ¥{{item.profitText}}</view>
          <view wx:elif="{{item.isReturn}}" class="muted">冲减毛利 ¥{{item.profitText}}</view>
      </view>
    </cell>
  </view>

  <view wx:if="{{loading}}" class="card quiet">正在加载…</view>
  <button wx:elif="{{loaded && list.length && hasMore}}" class="btn-ghost load-more js-load-more" bindtap="onLoadMore">加载更多</button>
  <view wx:elif="{{loaded && list.length && !hasMore}}" class="card quiet">没有更多了</view>
</view>
