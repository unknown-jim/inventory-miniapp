.stat-num {
  margin-top: var(--space-xs);
  color: #0F766E;
}

.stat-num.warm {
  color: #C2410C;
}

.chips {
  margin: var(--space-lg) 0 var(--space-md);
}

.list-card {
  padding: 8rpx 28rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}

.list-item:last-child {
  border-bottom: none;
}

.item-name {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.item-right {
  text-align: right;
}

.amount {
  margin-top: 8rpx;
  font-weight: 600;
}
