.stat-num {
  margin-top: var(--space-xs);
  color: #0F766E;
}

.stat-num.warm {
  color: #C2410C;
}

.chips {
  margin: var(--space-lg) 0 var(--space-md);
}

.list-card {
  padding: 8rpx 28rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}

.list-item:last-child {
  border-bottom: none;
}

.item-name {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.item-right {
  text-align: right;
}

.amount {
  margin-top: 8rpx;
  font-weight: 600;
}

/* 触底加载的两条脚注。和 index / customer-edit 的 .quiet 同一套灰。 */
.quiet {
  text-align: center;
  color: #64748B;
}

/* 触底不触发时的手动兜底。高度用共用 .btn-ghost（--tap-md），这里只管间距。 */
.load-more {
  margin-top: var(--space-md);
}
