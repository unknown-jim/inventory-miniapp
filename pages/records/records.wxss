/* 字号、字重、¥ 前缀归 amount 组件；这里只留颜色和外距 */
.stat-num {
  margin-top: var(--space-xs);
  color: var(--c-primary);
}

.stat-num.warm {
  color: var(--c-warn);
}

.chips {
  margin: var(--space-lg) 0 var(--space-md);
}

.list-card {
  padding: 8rpx 28rpx;
}

/* 行壳、分隔线（.cell-row）、右列对齐归 cell 组件与 app.wxss */
.item-name {
  font-weight: 600;
  margin-bottom: 8rpx;
}

/* 触底加载的两条脚注。和 index / customer-edit 的 .quiet 同一套灰。 */
.quiet {
  text-align: center;
  color: var(--c-muted);
}

/* 触底不触发时的手动兜底。高度用共用 .btn-ghost（--tap-md），这里只管间距。 */
.load-more {
  margin-top: var(--space-md);
}
