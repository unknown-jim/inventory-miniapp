.summary {
  display: flex;
}

.sum {
  flex: 1;
}

.sum-num {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #0F766E;
}

.sum-num.warm {
  color: #C2410C;
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 24rpx 0 16rpx;
}

.tab {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #64748B;
  font-size: 24rpx;
}

.tab.on {
  background: #0F766E;
  color: #FFFFFF;
}

.list-card {
  padding: 8rpx 28rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}

.list-item:last-child {
  border-bottom: none;
}

.item-name {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.item-right {
  text-align: right;
}

.amount {
  margin-top: 8rpx;
  font-weight: 600;
}
