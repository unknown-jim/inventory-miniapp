.stat-num {
  margin-top: var(--space-xs);
  color: #0F766E;
}

.stat-num.warm {
  color: #C2410C;
}

.chips {
  margin: var(--space-lg) 0 var(--space-md);
}

.list-card {
  padding: 8rpx 28rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}

.list-item:last-child {
  border-bottom: none;
}

.item-name {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.item-right {
  text-align: right;
}

.amount {
  margin-top: 8rpx;
  font-weight: 600;
}

/* 触底加载的两条脚注。和 index / customer-edit 的 .quiet 同一套灰。 */
.quiet {
  text-align: center;
  color: #64748B;
}

/* 触底不触发时的手动兜底。高度用共用 .btn-ghost（--tap-sm），这里只管间距。 */
.load-more {
  margin-top: var(--space-md);
}

/* FAB 压在列表右下角，所以页面底部要多留出 FAB 高度 + 间距，
   否则最后一行流水和「加载更多」会被它盖住。 */
.page {
  padding-bottom: 176rpx;
}

/* 稿 fab/记一笔 4:985：56×56 = 112rpx。0b 批把 --tap-lg 翻到文档值 104rpx 之后，
   新档位表里已经没有 56px 这一档，所以这里写字面量，不再借变量的数值。 */
.record-fab {
  position: fixed;
  right: var(--space-xl);
  bottom: calc(env(safe-area-inset-bottom) + var(--space-xl));
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  background: var(--color-fill-action);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 20, 26, 0.16);
  font-size: var(--fs-display);
  line-height: 1;
  color: var(--color-text-on-action);
}

.record-fab-press {
  background: var(--color-fill-action-pressed);
}
