.page {
  padding-bottom: 140rpx;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 8rpx 20rpx;
}

.toolbar .chips {
  margin-bottom: 0;
}

.toolbar .chip {
  margin-bottom: 0;
}

.link {
  color: #0F766E;
  font-size: var(--fs-sm);
}

.goods-card {
  margin-bottom: 16rpx;
  padding: 24rpx 28rpx 20rpx;
}

.goods-main {
  display: flex;
  align-items: flex-start;
  gap: var(--gap);
}

.goods-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: #f3f4f6;
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-text {
  font-size: var(--fs-md);
  color: #9ca3af;
}

.goods-info {
  flex: 1;
  min-width: 0;
}

.goods-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.goods-tags {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.item-name {
  font-size: var(--fs-lg);
  font-weight: 600;
}

.goods-price-grid {
  margin-top: var(--space-md);
}

.goods-spec-toggle {
  display: flex;
  align-items: center;
  min-height: var(--tap-sm);
  font-size: var(--fs-md);
  color: #0F766E;
}

.goods-spec-panel {
  margin-top: var(--space-sm);
}

.goods-spec-group-title {
  margin-bottom: var(--space-sm);
  color: #64748B;
  font-size: var(--fs-sm);
}

.warm {
  background: #FFF7ED;
  color: #C2410C;
}

.seed-btn {
  margin-top: 24rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  padding: 0 28rpx;
  height: var(--tap-md);
  line-height: var(--tap-md);
  font-size: var(--fs-lg);
  background: #0F766E;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(15, 118, 110, 0.28);
}
