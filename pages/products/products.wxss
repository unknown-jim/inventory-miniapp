.page {
  padding-bottom: 140rpx;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 8rpx 20rpx;
}

.toolbar .chips {
  margin-bottom: 0;
}

.toolbar .chip {
  margin-bottom: 0;
}

.link {
  color: #0F766E;
  font-size: var(--fs-sm);
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-md);
}

.goods-card {
  width: calc((100% - var(--space-md)) / 2);
  box-sizing: border-box;
  padding: 0;
  overflow: hidden;
  min-height: var(--tap-sm);
}

.goods-thumb {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 100%;
  overflow: hidden;
  background: #f3f4f6;
}

.thumb-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.thumb-text {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: var(--fs-hero);
  color: #9ca3af;
}

.goods-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-xs);
  padding: var(--space-md);
  min-width: 0;
}

.item-name {
  font-size: var(--fs-lg);
  font-weight: 600;
}

.seed-btn {
  margin-top: 24rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  padding: 0 28rpx;
  height: var(--tap-md);
  line-height: var(--tap-md);
  font-size: var(--fs-lg);
  background: #0F766E;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(15, 118, 110, 0.28);
}
