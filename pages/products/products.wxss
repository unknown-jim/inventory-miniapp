.page {
  padding-bottom: 140rpx;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 8rpx 20rpx;
}

.toolbar .chips {
  margin-bottom: 0;
}

.toolbar .chip {
  margin-bottom: 0;
}

.link {
  color: #0F766E;
  font-size: var(--fs-sm);
}

.goods-card {
  margin-bottom: 16rpx;
  padding: 24rpx 28rpx 20rpx;
}

.goods-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.goods-tags {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.item-name {
  font-size: var(--fs-lg);
  font-weight: 600;
}

.bar {
  height: 12rpx;
  margin: 20rpx 0 12rpx;
  background: #E2E8F0;
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #0F766E;
  border-radius: 999rpx;
}

.bar-fill.danger {
  background: #DC2626;
}

.price-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
  margin-top: 16rpx;
  color: #334155;
  font-size: var(--fs-sm);
}

.profit {
  color: #0F766E;
  font-weight: 600;
}

.warm {
  background: #FFF7ED;
  color: #C2410C;
}

.seed-btn {
  margin-top: 24rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  padding: 0 28rpx;
  height: var(--tap-md);
  line-height: var(--tap-md);
  font-size: var(--fs-lg);
  background: #0F766E;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(15, 118, 110, 0.28);
}
