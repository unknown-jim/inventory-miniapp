<view class="page">
  <page-loading wx:if="{{pageLoading}}" />
  <block wx:else>
  <input
    class="search"
    placeholder="搜索名称 / 货号 / 条码"
    value="{{keyword}}"
    bindinput="onSearch"
  />

  <view class="toolbar">
    <view class="chips">
      <view class="chip {{onlyAlert ? '' : 'on'}}" bindtap="showAll">全部</view>
      <view class="chip {{onlyAlert ? 'low' : ''}}" bindtap="showAlert">预警 {{alertCount}}</view>
    </view>
    <text class="link" bindtap="goRecords">流水</text>
  </view>

  <empty wx:if="{{!list.length && keyword}}" card title="没有匹配的商品" desc="换个名称、货号或条码再搜。" />
  <empty wx:elif="{{!list.length && onlyAlert}}" card title="暂时没有需要补货的商品" desc="预警数量在编辑商品里改。点「全部」看所有商品。" />
  <empty wx:elif="{{!list.length}}" card title="还没有商品" desc="先新增商品，再做进货和销售。">
    <button class="btn-primary seed-btn" bindtap="goAdd">新增商品</button>
  </empty>

  <view wx:else class="goods-grid">
    <view class="card goods-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goEdit">
      <view class="goods-thumb" wx:if="{{item.image && !item.imageFailed}}">
        <image class="thumb-img" src="{{item.image}}" mode="aspectFill" lazy-load binderror="onThumbError" data-index="{{index}}" />
      </view>
      <view class="goods-thumb thumb-empty" wx:else>
        <text class="thumb-text">{{item.thumbText}}</text>
      </view>
      <view class="goods-info">
        <view class="item-name">{{item.name}}</view>
        <view wx:if="{{item.sku}}" class="muted">货号 {{item.sku}}</view>
        <text class="tag {{item.lowStock ? 'tag-alert' : 'tag-ok'}}">库存 {{item.stock}}</text>
      </view>
    </view>
  </view>

  <fab text="+ 新增" bind:press="goAdd" />
  </block>
</view>
