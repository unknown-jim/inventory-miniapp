<view class="page">
  <page-loading wx:if="{{pageLoading}}" />
  <block wx:else>
  <input
    class="search"
    placeholder="搜索名称 / 货号 / 条码"
    value="{{keyword}}"
    bindinput="onSearch"
  />

  <view class="toolbar">
    <view class="chips">
      <view class="chip {{onlyAlert ? '' : 'on'}}" bindtap="showAll">全部</view>
      <view class="chip {{onlyAlert ? 'low' : ''}}" bindtap="showAlert">预警 {{alertCount}}</view>
    </view>
    <text class="link" bindtap="goRecords">流水</text>
  </view>

  <view wx:if="{{!list.length}}" class="card empty">
    <block wx:if="{{keyword}}">
      <view class="empty-title">没有匹配的商品</view>
      <view class="muted">换个名称、货号或条码再搜。</view>
    </block>
    <block wx:elif="{{onlyAlert}}">
      <view class="empty-title">当前没有低于预警的商品</view>
      <view class="muted">预警数量在编辑商品里改。点「全部」看所有商品。</view>
    </block>
    <block wx:else>
      <view class="empty-title">还没有商品</view>
      <view class="muted">先新增商品，再做进货和销售。</view>
      <button class="btn-primary seed-btn" bindtap="goAdd">新增商品</button>
    </block>
  </view>

  <view class="card goods-card" wx:for="{{list}}" wx:key="id">
    <view class="goods-main" data-id="{{item.id}}" bindtap="goEdit">
      <view class="goods-top">
        <view class="item-name">{{item.name}}</view>
        <view class="goods-tags">
          <text class="tag {{item.lowStock ? 'tag-alert' : 'tag-ok'}}">库存 {{item.stock}}</text>
        </view>
      </view>
      <view wx:if="{{item.sku}}" class="muted">货号 {{item.sku}}</view>
      <view wx:if="{{item.hasSpecs}}" class="muted">{{item.specLineText}}</view>
      <view class="stat-grid goods-price-grid">
        <view class="stat">
          <view class="muted">进价</view>
          <view class="stat-num">¥{{item.costText}}</view>
        </view>
        <view class="stat">
          <view class="muted">售价</view>
          <view class="stat-num">¥{{item.saleText}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{item.hasSpecs}}" class="goods-spec-toggle" data-id="{{item.id}}" catchtap="toggleSpecs">
      {{item.id === expandedId ? '收起规格' : '查看规格'}}
    </view>
    <view wx:if="{{item.hasSpecs && item.id === expandedId}}" class="goods-spec-panel">
      <view wx:if="{{!item.specGroups.length}}" class="muted">当前各规格都没有库存</view>
      <block wx:for="{{item.specGroups}}" wx:for-item="group" wx:key="key">
        <view wx:if="{{group.title}}" class="goods-spec-group-title">{{group.title}}</view>
        <view class="chips">
          <view class="chip {{chip.low ? 'low' : ''}}" wx:for="{{group.chips}}" wx:for-item="chip" wx:key="key">{{chip.label}}</view>
        </view>
      </block>
    </view>
    <view class="action-strip">
      <button class="btn-ghost" data-id="{{item.id}}" catchtap="goPurchase">进货</button>
      <button class="btn-ghost warm" data-id="{{item.id}}" catchtap="goSale">销售</button>
      <button wx:if="{{item.hasSpecs}}" class="btn-ghost" data-id="{{item.id}}" catchtap="goConvert">改规格</button>
    </view>
  </view>

  <view class="fab" bindtap="goAdd">+ 新增</view>
  </block>
</view>
