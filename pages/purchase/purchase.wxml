<view class="page">
  <view class="card">
    <view class="field">
      <view class="field-label">商品</view>
      <view class="field-input picker" bindtap="openPicker">{{productName}}</view>
    </view>
    <view class="meta">当前库存 {{stockText}}</view>
    <view class="spec-block" wx:if="{{hasSpecs}}">
      <view class="field" wx:if="{{colors.length}}">
        <view class="field-label">颜色</view>
        <view class="chips">
          <view
            class="chip {{item.on ? 'on' : ''}}"
            wx:for="{{colorOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="pickColor"
          >{{item.value}}</view>
        </view>
      </view>
      <view class="field" wx:if="{{sizes.length}}">
        <view class="field-label">尺码</view>
        <view class="chips">
          <view
            class="chip {{item.on ? 'on' : ''}}"
            wx:for="{{sizeOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="pickSize"
          >{{item.value}} {{item.stock}}</view>
        </view>
      </view>
    </view>
    <view class="field-row">
      <view class="field half">
        <view class="field-label">数量</view>
        <input class="field-input" type="digit" data-field="qty" value="{{qty}}" bindinput="onField" placeholder="0" hidden="{{showPicker}}" />
      </view>
      <view class="field half">
        <view class="field-label">本次进价</view>
        <input class="field-input" type="digit" data-field="unitPrice" value="{{unitPrice}}" bindinput="onField" placeholder="0.00" hidden="{{showPicker}}" />
      </view>
    </view>
    <view class="field">
      <view class="field-label">备注</view>
      <input class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="可选" hidden="{{showPicker}}" />
    </view>
    <view class="total">
      <text>进货金额</text>
      <text class="total-num">¥{{amountText}}</text>
    </view>
    <view class="muted tip">{{hasSpecs ? '本次进价会更新该规格的进价，之后销售按新进价算毛利。' : '本次进价会更新该商品的进价，之后销售按新进价算毛利。'}}</view>
  </view>

  <button class="btn-primary save-btn" bindtap="submit" hidden="{{showPicker}}">确认入库</button>

  <view wx:if="{{showPicker}}" class="mask" bindtap="closePicker">
    <view class="sheet" catchtap="closePickerKeep">
      <view class="sheet-title">选择商品</view>
      <input class="search" placeholder="搜索商品" value="{{keyword}}" bindinput="onSearch" />
      <scroll-view scroll-y class="sheet-list">
        <view
          class="sheet-item"
          wx:for="{{filtered}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPick"
        >
          <view>
            <view class="item-name">{{item.name}}</view>
            <view class="muted">
              <block wx:if="{{item.hasSpecs}}">多规格 · </block>货号 {{item.sku || '未填'}} · 库存 {{item.stock}}
            </view>
          </view>
          <text class="muted">进价 ¥{{item.costText}}</text>
        </view>
        <view wx:if="{{!filtered.length}}" class="empty">没有匹配商品</view>
      </scroll-view>
    </view>
  </view>
</view>
