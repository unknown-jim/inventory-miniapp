<view class="page">
  <page-loading wx:if="{{pageLoading}}" />
  <block wx:else>
  <view class="card">
    <field label="商品" mode="picker" value="{{productName}}" bindtap="openPicker" />
    <view class="meta">当前库存 {{stockText}}<text wx:if="{{blankProcess}}">（待加工）</text></view>
    <view class="spec-block" wx:if="{{hasSpecs && !blankProcess}}">
      <field label="{{specAxis1}}" dense wx:if="{{colors.length}}">
        <view class="chips">
          <view
            class="chip {{item.on ? 'on' : ''}}"
            wx:for="{{colorOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="pickColor"
          >{{item.value}}</view>
        </view>
      </field>
      <field label="{{specAxis2}}" dense wx:if="{{sizes.length}}">
        <view class="chips">
          <view
            class="chip {{item.on ? 'on' : ''}}"
            wx:for="{{sizeOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="pickSize"
          >{{item.value}} {{item.stock}}</view>
        </view>
      </field>
    </view>
    <view class="field-row">
      <field label="数量" class="half">
        <input class="field-input" type="digit" data-field="qty" value="{{qty}}" bindinput="onField" placeholder="0" hidden="{{showPicker}}" />
      </field>
      <field label="本次进价" class="half">
        <input class="field-input" type="digit" data-field="unitPrice" value="{{unitPrice}}" bindinput="onField" placeholder="0.00" hidden="{{showPicker}}" />
      </field>
    </view>
    <field label="备注">
      <input class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="可选" hidden="{{showPicker}}" />
    </field>
    <view class="total">
      <text>进货金额</text>
      <amount class="total-num" role="display" text="{{amountText}}" />
    </view>
    <view class="muted tip">{{blankProcess ? '进货记入待加工库存。销售时再选规格；规格格和待加工库存不是一回事。' : (hasSpecs ? '本次进价会更新该规格的进价，之后销售按新进价算毛利。' : '本次进价会更新该商品的进价，之后销售按新进价算毛利。')}}</view>
  </view>

  <button class="btn-primary save-btn" bindtap="submit" hidden="{{showPicker}}">确认入库</button>

  <sheet wx:if="{{showPicker}}" bind:close="closePicker">
    <view class="sheet-title">选择商品</view>
    <input class="search" placeholder="搜索商品" value="{{keyword}}" bindinput="onSearch" />
    <scroll-view scroll-y class="sheet-list">
      <view
        class="sheet-item"
        wx:for="{{filtered}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onPick"
      >
        <image wx:if="{{item.image && !item.imageFailed}}" class="sheet-thumb" src="{{item.image}}" mode="aspectFill" lazy-load binderror="onSheetThumbError" data-index="{{index}}" />
        <view class="sheet-body">
          <view class="item-name">{{item.name}}</view>
          <view class="muted">
            <block wx:if="{{item.specTag}}">{{item.specTag}} · </block>货号 {{item.sku || '未填'}} · 库存 {{item.stock}}
          </view>
        </view>
        <text class="muted">进价 ¥{{item.costText}}</text>
      </view>
      <empty wx:if="{{!filtered.length}}" desc="没有匹配商品" />
    </scroll-view>
  </sheet>
  </block>
</view>
