.picker {
  line-height: var(--tap-md);
}

.meta {
  margin: -8rpx 0 24rpx;
  color: var(--c-primary);
  font-size: var(--fs-label);
}

.spec-block .field {
  margin-bottom: 8rpx;
}

.spec-block .chips {
  margin-bottom: 8rpx;
}

.total,
.sheet-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.total {
  padding-top: 8rpx;
  font-weight: 600;
}

.total-num {
  font-size: var(--fs-display);
  color: var(--c-primary);
}

.tip {
  margin-top: 16rpx;
}

.save-btn {
  margin-top: 32rpx;
}

.sheet-title {
  font-size: var(--fs-title);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.sheet-list {
  height: 560rpx;
}

.sheet-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--c-line);
}

.sheet-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-xs);
  flex-shrink: 0;
  margin-right: var(--gap);
  background: var(--c-surface);
}

.sheet-body {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-weight: 600;
  margin-bottom: 6rpx;
}
