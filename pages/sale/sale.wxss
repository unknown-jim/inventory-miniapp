.meta {
  margin: -8rpx 0 24rpx;
  color: var(--c-warn);
  font-size: var(--fs-label);
}

.spec-block .chips {
  margin-bottom: 8rpx;
}

.customer-meta {
  margin: -8rpx 0 24rpx;
  color: var(--c-muted);
  font-size: var(--fs-label);
}

.field-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.field-head .field-label {
  margin-bottom: 0;
}

.link {
  color: var(--c-primary);
  font-size: var(--fs-label);
}

.total,
.sheet-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.right {
  text-align: right;
}

.total-num,
.profit-num {
  margin-top: 8rpx;
  font-size: var(--fs-display);
  font-weight: 700;
}

.total-num {
  color: var(--c-warn);
}

.profit-num {
  color: var(--c-primary);
}

.tip {
  margin-top: 16rpx;
}

.add-card {
  margin-top: 16rpx;
}

.line-amount {
  margin-bottom: 16rpx;
  color: var(--c-muted);
  font-size: var(--fs-label);
}

.add-btn {
  margin: 0;
}

.cart-card,
.total-card {
  margin-top: 16rpx;
}

.cart-head {
  margin-bottom: 8rpx;
  font-weight: 600;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--c-line);
}

.cart-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.cart-right {
  text-align: right;
}

.cart-amount {
  margin-bottom: 6rpx;
  font-weight: 600;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.sheet-head .sheet-title {
  margin-bottom: 0;
}

.sheet-title {
  font-size: var(--fs-title);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.sheet-list {
  height: 560rpx;
}

.sheet-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--c-line);
}

.sheet-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-xs);
  flex-shrink: 0;
  margin-right: var(--gap);
  background: var(--c-surface);
}

.sheet-body {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-weight: 600;
  margin-bottom: 6rpx;
}

.slip-canvas {
  position: fixed;
  /* 挪出屏幕，避免 type=2d 原生组件盖住按钮；宽高由导出时写入，必须 ≥ dest 像素 */
  left: -20000px;
  top: 0;
  pointer-events: none;
  opacity: 0;
}

.paid-field {
  margin-top: 24rpx;
}

.paid-note {
  margin-top: 16rpx;
  font-size: var(--fs-label);
  font-weight: 600;
}

.paid-note.debt {
  color: var(--c-warn);
}

.paid-note.over {
  color: var(--c-danger);
}

.paid-note.done {
  color: var(--c-primary);
}
