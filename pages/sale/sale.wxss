@import '/styles/slip.wxss';

.picker {
  line-height: 80rpx;
}

.meta {
  margin: -8rpx 0 24rpx;
  color: #C2410C;
  font-size: 24rpx;
}

.spec-block .field {
  margin-bottom: 8rpx;
}

.spec-block .chips {
  margin-bottom: 8rpx;
}

.customer-meta {
  margin: -8rpx 0 24rpx;
  color: #64748B;
  font-size: 24rpx;
}

.field-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.field-head .field-label {
  margin-bottom: 0;
}

.link {
  color: #0F766E;
  font-size: 24rpx;
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.pay-tabs {
  display: flex;
  gap: 12rpx;
}

.pay-tab {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #F8FAF9;
  border-radius: 14rpx;
  color: #64748B;
  font-size: 28rpx;
}

.pay-tab.on {
  background: #0F766E;
  color: #FFFFFF;
  font-weight: 600;
}

.half {
  flex: 1;
}

.total,
.sheet-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.right {
  text-align: right;
}

.total-num,
.profit-num {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.total-num {
  color: #C2410C;
}

.profit-num {
  color: #0F766E;
}

.tip {
  margin-top: 16rpx;
}

.add-card {
  margin-top: 16rpx;
}

.line-amount {
  margin-bottom: 16rpx;
  color: #64748B;
  font-size: 24rpx;
}

.add-btn {
  margin: 0;
}

.cart-card,
.total-card {
  margin-top: 16rpx;
}

.cart-head {
  margin-bottom: 8rpx;
  font-weight: 600;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}

.cart-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.cart-right {
  text-align: right;
}

.cart-amount {
  margin-bottom: 6rpx;
  font-weight: 600;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 24rpx 12rpx;
  position: relative;
  z-index: 1001;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.sheet-head .sheet-title {
  margin-bottom: 0;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.sheet-list {
  height: 560rpx;
}

.sheet-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}

.item-name {
  font-weight: 600;
  margin-bottom: 6rpx;
}
