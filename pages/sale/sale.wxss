.picker {
  line-height: var(--tap-md);
}

.meta {
  margin: -8rpx 0 24rpx;
  color: #C2410C;
  font-size: var(--fs-sm);
}

.spec-block .field {
  margin-bottom: 8rpx;
}

.spec-block .chips {
  margin-bottom: 8rpx;
}

.customer-meta {
  margin: -8rpx 0 24rpx;
  color: #64748B;
  font-size: var(--fs-sm);
}

.field-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.field-head .field-label {
  margin-bottom: 0;
}

.link {
  color: #0F766E;
  font-size: var(--fs-sm);
}

.total,
.sheet-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.right {
  text-align: right;
}

.total-num,
.profit-num {
  margin-top: 8rpx;
  font-size: var(--fs-xl);
  font-weight: 700;
}

.total-num {
  color: #C2410C;
}

.profit-num {
  color: #0F766E;
}

.tip {
  margin-top: 16rpx;
}

.add-card {
  margin-top: 16rpx;
}

.line-amount {
  margin-bottom: 16rpx;
  color: #64748B;
  font-size: var(--fs-sm);
}

.add-btn {
  margin: 0;
}

.cart-card,
.total-card {
  margin-top: 16rpx;
}

.cart-head {
  margin-bottom: 8rpx;
  font-weight: 600;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}

.cart-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.cart-right {
  text-align: right;
}

.cart-amount {
  margin-bottom: 6rpx;
  font-weight: 600;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 24rpx 12rpx;
  position: relative;
  z-index: 1001;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.sheet-head .sheet-title {
  margin-bottom: 0;
}

.sheet-title {
  font-size: var(--fs-lg);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.sheet-list {
  height: 560rpx;
}

.sheet-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}

.sheet-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  margin-right: var(--gap);
  background: #f3f4f6;
}

.sheet-body {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-weight: 600;
  margin-bottom: 6rpx;
}

.slip-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 1760px;
  height: 4000px;
  pointer-events: none;
  opacity: 0;
}

.paid-field {
  margin-top: 24rpx;
}

.paid-note {
  margin-top: 16rpx;
  font-size: var(--fs-sm);
  font-weight: 600;
}

.paid-note.debt {
  color: #C2410C;
}

.paid-note.over {
  color: #DC2626;
}

.paid-note.done {
  color: #0F766E;
}
