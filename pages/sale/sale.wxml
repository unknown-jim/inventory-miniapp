<!-- 销售出库。稿 Screen/05 销售出库 3:704 + Col/注释与弹层 3:731。
     首屏自上而下：客户卡 / 经手人备注折叠行 / 商品字段 / 规格卡 / 数量+售价 /
     加入清单 / 清单折叠行；底部固定 = 实收摘要行 + 确认销售（稿 bottom-cta 4:112）。
     实收、清单展开、商品 picker、客户 picker 四个弹层共用 .mask + .sheet。 -->
<view class="page">
  <page-loading wx:if="{{pageLoading}}" />
  <block wx:else>

  <!-- 稿 card/客户 3:708：白卡 r12，左名称 + 副行账户句，右 chevron。
       副行口径见 n-客户卡预收 10:155：有欠款只写欠款，无欠款有预收才写「预收可抵」。 -->
  <view class="cust-card js-customer-picker" bindtap="openCustomerPicker">
    <view class="cust-col">
      <view class="cust-name">{{customerName}}</view>
      <view class="cust-sub">{{customerSub}}</view>
      <view wx:if="{{customerMeta}}" class="cust-sub">{{customerMeta}}</view>
    </view>
    <view class="chev"></view>
  </view>

  <!-- 稿 row/经手人备注·收起 4:653 + n10 4:690：默认收起，展开 = 经手人输入 + 成员 chips + 备注框 -->
  <view class="fold-row js-info-row" bindtap="toggleInfo">
    <text class="fold-title">经手人 · 备注</text>
    <text class="fold-hint">{{infoHint}}</text>
    <view class="chev"></view>
  </view>
  <view wx:if="{{infoOpen}}" class="card info-card">
    <view class="field">
      <view class="field-label">经手人</view>
      <input class="field-input" maxlength="32" value="{{operatorName}}" bindinput="onOperatorName" placeholder="可选，默认自己" hidden="{{showPicker || showCustomerPicker || showSlip || showPaid || showCart}}" />
      <view wx:if="{{members.length}}" class="muted field-hint">点选本店成员，也可手写</view>
      <view class="chips" wx:if="{{members.length}}">
        <view
          class="chip {{item.on ? 'on' : ''}}"
          wx:for="{{members}}"
          wx:key="openid"
          data-openid="{{item.openid}}"
          bindtap="pickOperator"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="field last">
      <view class="field-label">备注</view>
      <input class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="可选，会写在送货单上" hidden="{{showPicker || showCustomerPicker || showSlip || showPaid || showCart}}" />
    </view>
  </view>

  <!-- 稿 picker/字段/selected 4:52：neutral/100 底 + border/default 描边 + chevron -->
  <view class="pick-field js-product-picker" bindtap="openPicker">
    <text class="pick-value">{{productName}}</text>
    <view class="chev"></view>
  </view>

  <!-- 稿 picker/格选择器 3:716：白卡 r12，label「选择规格」+ chips 折行 + 琥珀说明。
       两条轴仍然分两行（n5 3:767「双规格级联：先选规格一取值、再选规格二取值」）。
       裁定 A（批 2/2026-09-02）：规格二选中 >= 2 格时整卡切到多选形态（稿 22:244 S1），
       卡内顺序 = 规格一 -> 规格二(可多选)+全选 -> 全部填/单价 -> 逐格 -> 琥珀 -> 合计 ->
       红字 -> 按钮，一路画在同一张卡里；<= 1 格时回落这张卡原来的样子。与 bb40367 之前
       那个「原来的样子」比，规格二行有两处差别：一是上面 22:240 那条 `.disabled` 判据
       （批 2 加的），二是行末尾多了那枚「全选」chip（稿 23:53，2026-09-02 补）——形态
       切换管的是规格二行**以下**的东西，不是规格二行本身。 -->
  <view class="card spec-card" wx:if="{{hasSpecs}}">
    <block wx:if="{{multiMode}}">
      <view class="field" wx:if="{{colors.length}}">
        <view class="field-label">选择{{specAxis1}}</view>
        <view class="chips">
          <view
            class="chip js-color-chip {{item.on ? 'on' : ''}}"
            wx:for="{{colorOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="pickColor"
          >{{item.value}}</view>
        </view>
      </view>
      <!-- 这一支里 (colors.length && !selectedColor) 恒为 false，所以规格二 chips 与
           「全选」都不写禁用态：进多选形态的唯一通路是 pickSize / pickAllSizes，两者
           开头都被「规格一未选就 return」的守卫拦着，没选规格一根本走不到 |Z| >= 2。
           UX 注释 22:240 那条「规格一未选时规格二 chips 与全选一律禁用」说的是**级联档
           的单选形态**，所以它同时覆盖的这两类 chip 都落在下面 wx:else 那一支上（真会
           遇到这个状态的是它，稿 23:55 就是那一态的样张）；写在这里只会是恒假的死代码。 -->
      <view class="field">
        <view class="field-label">选择{{specAxis2}}（可多选）</view>
        <view class="chips">
          <view
            class="chip js-size-chip {{item.on ? 'on' : ''}}"
            wx:for="{{sizeOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="pickSize"
          >{{item.value}}</view>
          <view
            wx:if="{{sizes.length > 1}}"
            class="chip js-size-all {{allSizesOn ? 'on' : ''}}"
            bindtap="pickAllSizes"
          >全选</view>
        </view>
      </view>

      <!-- 稿 row/批量填数 22:95：全部填 + 单价并入同一行，单价在多选态下是输入框
           （与主屏 7:9 同形，不是只读文本）。 -->
      <view class="field-row batch-row">
        <view class="field half">
          <view class="field-label">全部填</view>
          <view class="qty-box">
            <input class="qty-input js-batch-qty" type="digit" value="{{batchQty}}" bindinput="onBatchQty" placeholder="0" hidden="{{showPicker || showCustomerPicker || showSlip || showPaid || showCart}}" />
          </view>
        </view>
        <view class="field half">
          <view class="field-label">单价</view>
          <view class="qty-box">
            <input class="qty-input price-input js-batch-price" type="digit" data-field="unitPrice" value="{{unitPrice}}" bindinput="onField" placeholder="0.00" hidden="{{showPicker || showCustomerPicker || showSlip || showPaid || showCart}}" />
          </view>
        </view>
      </view>

      <!-- 稿 row/逐格 22:102：一行最多两格，超过两格折行，不缩字号
           （docs/ui-scale.md「表单并排最多两格」）。hint 用「现货 N」不用「可出 N」
           （裁定 B）；判红只在整批 assertSaleItems 失败时才逐格增量定位到第一格。 -->
      <view class="cell-grid">
        <view class="cell-cell" wx:for="{{cellRows}}" wx:key="value">
          <view class="field-label">{{item.value}}</view>
          <view class="qty-box {{item.over ? 'danger' : ''}}">
            <input class="qty-input js-cell-qty" type="digit" value="{{item.qtyText}}" data-value="{{item.value}}" bindinput="onCellQty" placeholder="0" hidden="{{showPicker || showCustomerPicker || showSlip || showPaid || showCart}}" />
          </view>
          <text class="cell-hint {{item.over ? 'danger' : ''}}">{{item.hint}}</text>
        </view>
      </view>

      <!-- 琥珀行：整批一行汇总，不逐格出（13:139;3:429，n9 4:19 的多选口径） -->
      <view wx:if="{{blankNote}}" class="blank-note js-blank-note">{{blankNote}}</view>

      <!-- 合计行。裁定 C：N = 有正数量的格数（不是选中格数），N = 0 时整行不出 -->
      <view wx:if="{{batchLineCount > 0}}" class="batch-total">
        <text class="batch-total-label">本批 {{batchLineCount}} 格 · 合计</text>
        <text class="batch-total-amount">¥{{lineAmountText}}</text>
      </view>

      <!-- 卡级红字：只出一句（后端抛的第一条），逐字取 error.message，不许另编 -->
      <view wx:if="{{overNote}}" class="over-note js-over-note">{{overNote}}</view>

      <button class="add-btn js-add-cart" bindtap="addCart" disabled="{{!canAdd}}" hidden="{{showPicker || showCustomerPicker || showSlip || showPaid || showCart}}">{{addBtnLabel}}</button>
    </block>
    <block wx:else>
      <view class="spec-label">选择规格</view>
      <view class="field" wx:if="{{colors.length}}">
        <view class="field-label">{{specAxis1}}</view>
        <view class="chips">
          <view
            class="chip js-color-chip {{item.on ? 'on' : ''}}"
            wx:for="{{colorOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="pickColor"
          >{{item.value}}</view>
        </view>
      </view>
      <!-- UX 注释 22:240：「规格一未选时，规格二 chips 与「全选」一律禁用（实底档：
           neutral/100 底 + neutral/500 字，不透明）」。行为侧的守卫在 pickSize 开头，
           视觉侧就是这里的 .disabled ——两者必须落在同一支上，否则 chip 长得跟能点的
           一模一样、点了却没反应（baseline 是允许「先点尺码后点颜色」的，稿改了这条
           规则，那就得让「不能点」看起来也不能点）。
           「全选」chip 在这一支里也要出：进多选形态要选中 2 格，而「从空态一次选满」
           正是它存在的理由——只画进多选形态，这个入口就永远够不到（2026-09-02 修）。
           它的禁用判据与同行 size chip 逐字相同，22:240 那半条正是对它说的。 -->
      <view class="field last" wx:if="{{sizes.length}}">
        <view class="field-label">{{specAxis2}}</view>
        <view class="chips">
          <view
            class="chip js-size-chip {{item.on ? 'on' : ''}} {{item.low ? 'low' : ''}} {{(colors.length && !selectedColor) ? 'disabled' : ''}}"
            wx:for="{{sizeOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="pickSize"
          >{{item.value}} {{item.stock}}</view>
          <!-- 稿 23:53「card/单选·级联（全选可见）」：全选放在这一行最后一枚，与
               22:276 / 22:244 一致。allSizesOn 在单选形态恒为 false（|Z| <= 1 而
               |S| >= 2），所以这里永远画未选中态——符合 22:234，不是漏画选中态。 -->
          <view
            wx:if="{{sizes.length > 1}}"
            class="chip js-size-all {{allSizesOn ? 'on' : ''}} {{(colors.length && !selectedColor) ? 'disabled' : ''}}"
            bindtap="pickAllSizes"
          >全选</view>
        </view>
      </view>
      <!-- 稿 13:139;3:429：仅现货不足、真的要从半成品扣时才出现（n9 4:19 / n16 7:33） -->
      <view wx:if="{{blankNote}}" class="blank-note js-blank-note">{{blankNote}}</view>
    </block>
  </view>

  <!-- 单选形态：既有数量+售价/本行金额/红字/加入清单，一个字不改。
       多选形态把这些内容画进了上面的 spec-card，这里整段不出。 -->
  <block wx:if="{{!multiMode}}">
    <!-- 稿 field-row/数量+售价 7:1：数量框内右侧带「件 · 可出 N」（unit 7:6） -->
    <view class="field-row">
      <view class="field half">
        <view class="field-label">数量</view>
        <view class="qty-box">
          <input class="qty-input js-qty" type="digit" data-field="qty" value="{{qty}}" bindinput="onField" placeholder="0" hidden="{{showPicker || showCustomerPicker || showSlip || showPaid || showCart}}" />
          <text class="qty-unit">件 · 可出 {{stockText}}</text>
        </view>
      </view>
      <view class="field half">
        <view class="field-label">本次售价</view>
        <view class="qty-box">
          <input class="qty-input price-input" type="digit" data-field="unitPrice" value="{{unitPrice}}" bindinput="onField" placeholder="0.00" hidden="{{showPicker || showCustomerPicker || showSlip || showPaid || showCart}}" />
        </view>
      </view>
    </view>
    <view class="line-amount">本行 ¥{{lineAmountText}}</view>

    <!-- 稿 13:614：清单累计超出现货且半成品不够时的红字拦截（n16 7:33） -->
    <view wx:if="{{overNote}}" class="over-note js-over-note">{{overNote}}</view>

    <!-- 稿 btn/加入清单 4:65 / 拦截样张 13:615：禁用走 app.wxss 的 .btn-primary[disabled] 实底档 -->
    <button class="add-btn js-add-cart" bindtap="addCart" disabled="{{!canAdd}}" hidden="{{showPicker || showCustomerPicker || showSlip || showPaid || showCart}}">加入清单</button>
  </block>

  <!-- 稿 row/销售清单·折叠 7:11：点开走弹层，不在首屏内联撑开（n15 7:32） -->
  <view wx:if="{{cart.length}}" class="fold-row cart-row js-cart-row" bindtap="openCart">
    <text class="fold-title">{{cartHead}}</text>
    <text class="cart-total">合计 ¥{{amountText}}</text>
    <view class="chev"></view>
  </view>

  <!-- 底栏占位：底栏是 fixed，正常文档流要留出等高的空白，否则清单行会被盖住 -->
  <view class="cta-hold"></view>

  <!-- 稿 bottom-cta 4:112：hairline + 实收摘要行 + 确认销售 + 安全区 -->
  <view class="cta-bar">
    <view class="cta-inner">
      <view class="paid-row js-paid-row" bindtap="openPaid">
        <view class="paid-left">
          <text class="paid-k">实收</text>
          <text class="paid-v">¥{{paidAmount || '0.00'}}</text>
        </view>
        <text class="paid-hint">{{summaryHint}}</text>
        <view class="chev"></view>
      </view>
      <button class="btn-primary submit-btn js-sale-submit" bindtap="submit" disabled="{{!cart.length && !canAdd}}" hidden="{{showPicker || showCustomerPicker || showSlip || showPaid || showCart}}">确认销售</button>
    </view>
  </view>

  <!-- ============ 实收 sheet。稿 7:25 / 7:404 / 10:180 / 7:230 四态同一套结构 ============ -->
  <view wx:if="{{showPaid}}" class="mask" bindtap="closePaid">
    <view class="sheet" catchtap="closePickerKeep">
      <view class="sheet-title center">{{sheetTitle}}</view>
      <view class="pay-row">
        <view class="pay-total">合计 ¥{{amountText}}</view>
        <view class="muted">共 {{qtyTotal}} 件</view>
      </view>

      <!-- 稿 hint/预收未用 13:330：抵扣关且客户有余额时出现，整行可点打开抵扣 -->
      <view wx:if="{{customerPrepay > 0 && !prepayOn}}" class="prepay-hint js-prepay-hint" bindtap="togglePrepay">预收可抵 ¥{{prepayText}} · 本单未用（可点打开抵扣）</view>

      <!-- 稿 row/预收抵扣 7:424：k + 绿色负数 + 44 热区的 × 关抵扣 -->
      <view wx:if="{{prepayOn && prepayUsed > 0}}" class="prepay-row">
        <text class="prepay-k">预收款抵扣（{{customerName}}预存）</text>
        <text class="prepay-v">−¥{{prepayUsedText}}</text>
        <view class="prepay-x js-prepay-off" catchtap="togglePrepay">×</view>
      </view>

      <input class="paid-input js-paid" type="digit" value="{{paidAmount}}" bindinput="onPaidInput" placeholder="0.00" hidden="{{showPicker || showCustomerPicker || showSlip}}" />

      <!-- 稿 快捷chips 4:658 / 7:408 / 10:184：第三枚只在客户有预收余额时出现（n11 4:691） -->
      <view class="chips">
        <view class="chip js-paid-full" bindtap="fillPaidFull">收满 ¥{{cashDueText}}</view>
        <view class="chip js-paid-none" bindtap="fillPaidNone">一分未收</view>
        <view wx:if="{{customerPrepay > 0}}" class="chip {{prepayOn ? 'on' : ''}} js-paid-prepay" bindtap="togglePrepay">抵预收 ¥{{prepayText}}</view>
      </view>

      <view wx:if="{{feedbackText}}" class="pay-feedback {{feedbackDanger ? 'danger' : ''}} js-paid-feedback">{{feedbackText}}</view>

      <!-- 稿 散客拦截态 7:230 的 btn/选客户 13:522 -->
      <button wx:if="{{paidBlocked && !customerId}}" class="pick-cust-btn js-paid-pick-cust" bindtap="goPickCustomer">选客户</button>

      <button class="btn-primary sheet-confirm js-paid-confirm" bindtap="confirmPaid" disabled="{{paidBlocked}}" hidden="{{showPicker || showCustomerPicker || showSlip}}">{{confirmText}}</button>
      <view class="sheet-cancel js-paid-cancel" bindtap="closePaid">取消</view>
    </view>
  </view>

  <!-- ============ 清单展开 sheet。稿 card/销售清单·展开态 3:746 + 清单行 3:722 ============ -->
  <view wx:if="{{showCart}}" class="mask" bindtap="closeCart">
    <view class="sheet" catchtap="closePickerKeep">
      <view class="sheet-title">{{cartHead}}</view>
      <scroll-view scroll-y class="sheet-list">
        <view class="cart-item" wx:for="{{cart}}" wx:key="key">
          <view class="cart-head">
            <view class="cart-col">
              <view class="item-name">{{item.name}}</view>
              <view class="muted"><block wx:if="{{item.specText}}">{{item.specText}}</block></view>
            </view>
            <text class="cart-amount">¥{{item.amountText}}</text>
          </view>
          <view class="cart-ctrl">
            <view class="step-btn js-cart-minus" data-key="{{item.key}}" bindtap="stepDown">−</view>
            <input class="step-input js-cart-qty" type="digit" value="{{item.qtyText}}" data-key="{{item.key}}" bindinput="onCartQty" hidden="{{showPicker || showCustomerPicker || showSlip}}" />
            <view class="step-btn js-cart-plus" data-key="{{item.key}}" bindtap="stepUp">＋</view>
            <view class="cart-spacer"></view>
            <view class="del-btn js-cart-del {{cart.length <= 1 ? 'off' : ''}}" data-key="{{item.key}}" bindtap="removeCart">×</view>
          </view>
        </view>
      </scroll-view>
      <view class="sheet-cancel js-cart-close" bindtap="closeCart">收起</view>
    </view>
  </view>

  <!-- ============ 商品 picker。稿 sheet/商品picker 4:667 ============ -->
  <view wx:if="{{showPicker}}" class="mask" bindtap="closePicker">
    <view class="sheet" catchtap="closePickerKeep">
      <view class="sheet-title">选择商品</view>
      <input class="search" placeholder="搜索商品" value="{{keyword}}" bindinput="onSearch" />
      <scroll-view scroll-y class="sheet-list">
        <view
          class="sheet-item js-product-item"
          wx:for="{{filtered}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPick"
        >
          <image wx:if="{{item.image && !item.imageFailed}}" class="sheet-thumb" src="{{item.image}}" mode="aspectFill" lazy-load binderror="onSheetThumbError" data-index="{{index}}" />
          <view class="sheet-body">
            <view class="item-name">{{item.name}}</view>
            <view class="muted">
              <block wx:if="{{item.specTag}}">{{item.specTag}} · </block>货号 {{item.sku || '未填'}} · 库存 {{item.stock}}
            </view>
          </view>
          <text class="muted">售价 ¥{{item.saleText}}</text>
        </view>
        <view wx:if="{{!filtered.length}}" class="empty">
          <view class="empty-title">无匹配</view>
          <view class="muted">无匹配时的空态。点「＋ 新增商品」建档，不取消开单。</view>
        </view>
      </scroll-view>
      <view class="chips">
        <view class="chip add js-add-product" bindtap="goAddProduct">＋ 新增商品</view>
      </view>
      <view class="sheet-cancel js-picker-cancel" bindtap="closePicker">取消</view>
    </view>
  </view>

  <!-- ============ 客户 picker。稿 sheet/select 7:90 与散客置灰变体 7:325 ============ -->
  <view wx:if="{{showCustomerPicker}}" class="mask" bindtap="closeCustomerPicker">
    <view class="sheet" catchtap="closePickerKeep">
      <view class="sheet-head">
        <view class="sheet-title">选择客户</view>
        <text class="link" catchtap="goAddCustomer">新增</text>
      </view>
      <input class="search" placeholder="搜索客户" value="{{customerKeyword}}" bindinput="onCustomerSearch" />
      <scroll-view scroll-y class="sheet-list">
        <!-- 稿 7:324：实收 ≠ 应收时散客置灰不可选，与 sheet 内禁用确认钮成双闸（n2 3:737） -->
        <view class="sheet-item js-walkin {{walkinDisabled ? 'off' : ''}}" bindtap="clearCustomer">
          <view>
            <view class="item-name">散客</view>
            <view class="muted">{{walkinDisabled ? '本单实收不等于应收，散客不能选' : '不填写客户，送货单不显示收货人'}}</view>
          </view>
        </view>
        <view
          class="sheet-item js-customer-item"
          wx:for="{{filteredCustomers}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPickCustomer"
        >
          <view>
            <view class="item-name">{{item.name}}</view>
            <view class="muted">{{item.phone || '未填电话'}} · {{item.address || '未填地址'}}</view>
          </view>
        </view>
        <view wx:if="{{!filteredCustomers.length}}" class="empty">没有匹配客户</view>
      </scroll-view>
      <view class="sheet-cancel js-cust-cancel" bindtap="closeCustomerPicker">取消</view>
    </view>
  </view>

  <slip-overlay
    id="slip-overlay"
    show-slip="{{showSlip}}"
    slip="{{slip}}"
    exporting="{{exporting}}"
    show-picker="{{showPicker}}"
    show-customer-picker="{{showCustomerPicker}}"
    export-style="{{exportStyle}}"
    bind:close="closeSlip"
    bind:export="exportSlip"
    bind:stylechange="onSlipStyleChange"
  />
  </block>
  <canvas type="2d" id="slipCanvas" class="slip-canvas" style="width: {{slipCanvasWidth}}px; height: {{slipCanvasHeight}}px;"></canvas>
</view>
