/* 成员。共用类来自 app.wxss，这里只写本页布局：
   .page 与 .card 与 .muted 与 .tag 与 .tag-owner 与 .tag-staff 与 .section-title 与
   .field 与 .field-label 与 .field-input 与 .action-strip 与 .btn-primary 与 .btn-ghost。
   稿 Screen/14d 添加店员 15:214。 */

.card + .card {
  margin-top: var(--space-md);
}

/* 稿 card/成员 15:219：整卡不留上下内边距，行与行之间靠 15:222 那条 div h1 分隔 */
.list-card {
  padding: 0 var(--card-pad);
}

.member-row {
  padding: var(--space-md) 0;
}

.member-row + .member-row {
  border-top: 2rpx solid var(--color-border-default);
}

/* 稿 row/成员 15:221：横排 gap8（= 16rpx），中间一枚 fill_container 的 sp 把
   两枚文字链推到右端 */
.member-line {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

/* 稿 15:227 称呼：14px Medium neutral/900 */
.member-name {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--color-text-primary);
  word-break: break-all;
}

.member-gap {
  flex: 1;
  min-width: var(--space-sm);
}

/* 稿 15:230「改称呼」与 15:236「移出」：视觉 13px，热区靠透明 padding 撑到 44。
   docs/ui-scale.md 的「视觉小、热区不小」就是这一条。
   两枚之间的间距 = member-line 的 gap 16rpx 加上这里的 16rpx = 32rpx = 16px，
   正是稿 15:235 那枚 sp-热区间距 的宽度，保证两个 44 热区不重叠。 */
.row-link {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-height: var(--tap-min);
  padding: 0 var(--space-xs);
  color: var(--color-text-primary);
  font-size: var(--fs-label);
}

.row-link + .row-link {
  margin-left: var(--space-md);
}

/* 危险三级里最轻的一档：红字链，比店铺页清空的白底红描边轻一级、
   比删除店铺的实心红轻两级（规格 5.3）。形与 pages/product-edit 的
   danger-link 同源（那一处是 B5 落的，注释里记着同一条理由）。 */
.row-link.danger {
  color: var(--color-red-600);
}

/* 共用 .field 自带下外边距，卡里最后一格不要那一截 */
.last {
  margin-bottom: 0;
}

.member-edit .action-strip {
  margin-top: var(--space-md);
}

/* 底栏是 fixed，正常文档流要留出等高的空白，否则最后一块内容会被盖住。
   高度 = 按钮 104 + 上内边距 12 + 下内边距 24 + 安全区（同 pages/customer-edit） */
.cta-hold {
  height: calc(env(safe-area-inset-bottom) + 160rpx);
}

/* 稿 bottom-cta 15:243：hairline 15:244 做成 border-top，安全区 15:246 做成内边距 */
.cta-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  background: var(--color-bg-card);
  border-top: 2rpx solid var(--color-border-default);
}

.cta-inner {
  padding: var(--space-sm) var(--page-pad) calc(env(safe-area-inset-bottom) + var(--space-lg));
}

/* 店员那一侧没有钉底 CTA，按稿画布规范 9:24 在滚动流末尾留 34 安全区 */
.safe-area {
  height: calc(env(safe-area-inset-bottom) + 68rpx);
}
