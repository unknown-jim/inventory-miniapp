.openid {
  margin: 16rpx 0;
  padding: 20rpx 24rpx;
  background: #F8FAF9;
  border-radius: 14rpx;
  word-break: break-all;
  font-size: var(--fs-sm);
}

.copy-btn {
  margin-top: 12rpx;
}

.member-card {
  margin-bottom: 16rpx;
}

.item-name {
  font-size: var(--fs-md);
  font-weight: 600;
  word-break: break-all;
  margin-bottom: 8rpx;
}

.member-card .action-strip {
  margin-top: var(--space-md);
}

.member-card .action-strip .btn-danger {
  height: auto;
  min-height: var(--tap-sm);
  line-height: 1.3;
  padding-top: var(--space-sm);
  padding-bottom: var(--space-sm);
}

.quiet {
  text-align: center;
}
