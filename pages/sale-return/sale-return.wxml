<view class="page">
  <view class="card">
    <field label="客户" mode="readonly" value="{{customerName}}" />
    <field label="原单时间" mode="readonly" value="{{timeText}}" last />
  </view>

  <view class="card list-card">
    <view class="muted tip">退货按当时卖掉的规格原样入库。要换格，入库后再用「改规格」。</view>
    <view class="line" wx:for="{{lines}}" wx:key="id">
      <view class="item-name">{{item.productName}}</view>
      <view class="muted" wx:if="{{item.specText}}">{{item.specText}}</view>
      <view class="muted">已卖 {{item.soldText}} · 已退 {{item.returnedText}} · 可退 {{item.remainText}}</view>
      <field label="本次退货数量" last>
        <input
          class="field-input"
          type="digit"
          data-id="{{item.id}}"
          value="{{item.qty}}"
          bindinput="onQty"
          placeholder="0"
        />
      </field>
    </view>
    <field label="备注" last>
      <input class="field-input" data-field="remark" value="{{remark}}" bindinput="onRemark" placeholder="可选" />
    </field>
  </view>

  <button class="btn-primary save-btn" bindtap="submit">确认退货</button>
</view>
