  background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='48'%20height='48'%3E%3Cpath%20fill='%230F756E'%20transform='matrix(1%200%200%201%209.6%2020)'%20d='M29.3303%20-0.5303Q29.1144%20-0.759%2028.8%20-0.75L0%20-0.75Q-0.3144%20-0.759%20-0.5303%20-0.5303Q-0.759%20-0.3144%20-0.75%200L-0.75%2016Q-0.75%2017.3048%200.1726%2018.2274Q1.0952%2019.15%202.4%2019.15L26.4%2019.15Q27.7048%2019.15%2028.6274%2018.2274Q29.55%2017.3048%2029.55%2016L29.55%200Q29.559%20-0.3144%2029.3303%20-0.5303ZM28.05%200.75L0.75%200.75L0.75%2016Q0.75%2016.6835%201.2333%2017.1667Q1.7166%2017.65%202.4%2017.65L26.4%2017.65Q27.0834%2017.65%2027.5667%2017.1667Q28.05%2016.6834%2028.05%2016L28.05%200.75Z'%20fill-rule='evenodd'/%3E%3Cpath%20fill='%230F756E'%20transform='matrix(1%200%200%201%209.6%209.6)'%20d='M3.8068%200.9493L-0.6732%2010.0693L0.6732%2010.7307L5.148%201.6212Q5.358%201.2283%205.7381%200.9944Q6.1223%200.7579%206.5734%200.7499L22.24%200.75Q22.6777%200.7579%2023.0619%200.9944Q23.442%201.2283%2023.652%201.6212L28.1268%2010.7307L29.4732%2010.0693L24.9932%200.9493Q24.9908%200.9445%2024.9883%200.9397Q24.9859%200.9349%2024.9834%200.9301Q24.5816%200.1683%2023.8481%20-0.2831Q23.1146%20-0.7345%2022.24%20-0.75L6.5466%20-0.7499Q5.6855%20-0.7345%204.9519%20-0.2831Q4.2184%200.1683%203.8166%200.9301Q3.8141%200.9349%203.8116%200.9397Q3.8092%200.9445%203.8068%200.9493Z'%20fill-rule='evenodd'/%3E%3Cpath%20fill='%230F756E'%20transform='matrix(1%200%200%201%2019.2%2020)'%20d='M0.75%204.85L0.75%200L-0.75%200L-0.75%205.6Q-0.759%205.9144%20-0.5303%206.1303Q-0.3144%206.359%200%206.35L9.6%206.35Q9.9144%206.359%2010.1303%206.1303Q10.359%205.9144%2010.35%205.6L10.35%200L8.85%200L8.85%204.85L0.75%204.85Z'%20fill-rule='evenodd'/%3E%3C/svg%3E");
}
