<view class="page {{uiScaleClass}}">
  <view class="hero card">
    <view class="hero-top" hover-class="hero-press" bindtap="goRecords">
      <view>
        <view class="hero-kicker">{{dateText}}</view>
        <view class="hero-title">今日看板</view>
      </view>
      <view class="hero-profit">
        <view class="muted">今日毛利</view>
        <view class="hero-profit-num">¥{{todayProfit}}</view>
      </view>
    </view>
    <view class="stats">
      <view class="stat" hover-class="hero-press" bindtap="goProducts">
        <view class="stat-num">{{productCount}}</view>
        <view class="muted">商品数</view>
      </view>
      <view class="stat" hover-class="hero-press" bindtap="goInventory">
        <view class="stat-num">{{totalStock}}</view>
        <view class="muted">库存总量</view>
      </view>
      <view class="stat" hover-class="hero-press" bindtap="goTodaySales">
        <view class="stat-num">{{todaySalesAmount}}</view>
        <view class="muted">今日销售额</view>
      </view>
      <view class="stat {{alertCount ? 'stat-alert' : ''}}" hover-class="hero-press" bindtap="goAlerts">
        <view class="stat-num">{{alertCount}}</view>
        <view class="muted">库存预警</view>
      </view>
    </view>
  </view>

  <view class="actions">
    <button class="action" bindtap="goPurchase">进货入库</button>
    <button class="action action-warm" bindtap="goSale">销售出库</button>
    <button class="action action-plain" bindtap="goAddProduct">新增商品</button>
  </view>

  <view wx:if="{{hasReceivable}}" class="card debt-banner" bindtap="goCustomers">
    <view>
      <view class="muted">客户欠款</view>
      <view class="debt-banner-num">¥{{totalReceivable}}</view>
    </view>
    <text class="link">去收款</text>
  </view>

  <view wx:if="{{isEmpty}}" class="card empty-card">
    <view class="empty-title">还没有商品</view>
    <view class="muted">可以先填一份示例数据，看看进货、销售、预警和毛利怎么记。</view>
    <button class="btn-primary seed-btn" bindtap="seedDemo">填充示例数据</button>
  </view>

  <block wx:else>
    <view class="section-title">
      <text>库存预警</text>
      <text class="link" bindtap="goInventory">全部库存</text>
    </view>
    <view wx:if="{{alerts.length}}" class="card list-card">
      <view
        class="list-item"
        wx:for="{{alerts}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onAlertTap"
      >
        <view>
          <view class="item-name">{{item.name}}</view>
          <view class="muted">
            <block wx:if="{{item.hasSpecs}}">{{item.specHint || item.specTag}} · </block>货号 {{item.sku || '未填'}} · 预警 ≤ {{item.alertQty}}
          </view>
        </view>
        <view class="item-right">
          <text class="tag tag-alert">库存 {{item.stock}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="card quiet">当前没有低于预警的商品</view>

    <view class="section-title">
      <text>最近流水</text>
      <text class="link" bindtap="goRecords">查看全部</text>
    </view>
    <view wx:if="{{recent.length}}" class="card list-card">
      <view class="list-item" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="onRecordTap">
        <view>
          <view class="item-name">{{item.productName}}</view>
          <view class="muted">{{item.timeText}}<block wx:if="{{item.hasSpec}}"> · {{item.specText}}</block><block wx:if="{{item.isOut}}"> · {{item.qtyText}} 件</block><block wx:if="{{item.isMulti}}"> · {{item.lineCount}} 种</block><text wx:if="{{item.customerText}}"> · {{item.customerText}}</text></view>
        </view>
        <view class="item-right">
          <text class="tag {{item.tagClass}}">{{item.typeText}}</text>
          <view class="amount">¥{{item.amountText}}</view>
          <view wx:if="{{item.isOut || item.isReturn}}" class="muted">毛利 ¥{{item.profitText}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="card quiet">今天还没有进销记录</view>
  </block>

  <view class="section-title">
    <text>显示大小</text>
  </view>
  <view class="card scale-card">
    <view class="chips">
      <view class="chip {{uiScale === 'std' ? 'on' : ''}}" data-level="std" bindtap="setUiScale">标准</view>
      <view class="chip {{uiScale === 'lg' ? 'on' : ''}}" data-level="lg" bindtap="setUiScale">大</view>
      <view class="chip {{uiScale === 'xl' ? 'on' : ''}}" data-level="xl" bindtap="setUiScale">更大</view>
    </view>
    <view class="muted">字和按钮跟着变，可随时改。默认是「大」。</view>
  </view>

  <view class="footer-actions">
    <text class="link" bindtap="goRecords">流水与毛利汇总</text>
    <text class="link" bindtap="goCustomers">客户管理</text>
    <text class="link" bindtap="goCategories">种类模板</text>
    <text wx:if="{{!isEmpty}}" class="danger-link" bindtap="clearData">清空数据</text>
  </view>
</view>
