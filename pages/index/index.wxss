.hero {
  background: linear-gradient(160deg, #115E59 0%, #0F766E 58%, #0D9488 100%);
  color: #ECFDF5;
  padding: 36rpx 32rpx 28rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-kicker {
  font-size: 22rpx;
  opacity: 0.78;
}

.hero-title {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-profit {
  text-align: right;
}

.hero-profit-num {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.stats {
  display: flex;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}

.stat {
  flex: 1;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.stat .muted,
.hero-profit .muted {
  color: rgba(236, 253, 245, 0.72);
}

.stat-alert .stat-num {
  color: #FECACA;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 8rpx;
}

.action {
  flex: 1;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  background: #0F766E;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.action-warm {
  background: #C2410C;
}

.action-plain {
  background: #FFFFFF;
  color: #0F766E;
}

.debt-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.debt-banner-num {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #C2410C;
}

.seed-btn {
  margin-top: 28rpx;
}

.empty-card,
.quiet {
  text-align: center;
  color: #64748B;
}

.list-card {
  padding: 8rpx 28rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}

.list-item:last-child {
  border-bottom: none;
}

.item-name {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.item-right {
  text-align: right;
}

.amount {
  margin-top: 8rpx;
  font-weight: 600;
}

.link {
  color: #0F766E;
  font-size: 24rpx;
}

.footer-actions {
  display: flex;
  justify-content: space-between;
  margin: 36rpx 8rpx 0;
}

.danger-link {
  color: #DC2626;
  font-size: 24rpx;
}
