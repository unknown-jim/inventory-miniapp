.hero {
  background: var(--grad-hero);
  color: var(--c-hero-ink);
  padding: 36rpx 32rpx 28rpx;
}

.hero-shop {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: var(--tap-min);
  margin-bottom: var(--space-md);
  border-bottom: 1rpx solid var(--c-hero-line);
}

.hero-shop-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-title);
  word-break: break-word;
}

.hero-shop-go {
  flex-shrink: 0;
  margin-left: var(--gap);
  font-size: var(--fs-label);
  opacity: 0.78;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-kicker {
  font-size: var(--fs-caption);
  opacity: 0.78;
}

.hero-title {
  margin-top: 8rpx;
  font-size: var(--fs-display);
  font-weight: 700;
}

.hero-profit {
  text-align: right;
}

.hero-profit-num {
  margin-top: 8rpx;
  font-size: var(--fs-display);
  font-weight: 700;
}

.hero .stat-grid {
  margin-top: var(--space-xl);
  padding-top: var(--space-lg);
  border-top: 1rpx solid var(--c-hero-line);
}

.hero-press {
  opacity: 0.72;
}

.hero .stat-num {
  margin-bottom: 6rpx;
}

.stat .muted,
.hero-profit .muted {
  color: var(--c-hero-ink-soft);
}

.stat-alert .stat-num {
  color: var(--c-hero-danger);
}

.debt-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

/* 字号归 amount 组件（display 角色 48rpx）；这里只留色、距、字重 */
.debt-banner-num {
  margin-top: 8rpx;
  font-weight: 700;
  color: var(--c-warn);
}

.seed-btn {
  margin-top: 28rpx;
}

.btn-ghost {
  margin-top: 16rpx;
}

.quiet {
  text-align: center;
  color: var(--c-muted);
}

.list-card {
  padding: 8rpx 28rpx;
}

/* 行壳、分隔线（.cell-row）、右列对齐归 cell 组件与 app.wxss */
.item-name {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.link {
  color: var(--c-primary);
  font-size: var(--fs-label);
}
