.hero {
  background: linear-gradient(160deg, #115E59 0%, #0F766E 58%, #0D9488 100%);
  color: #ECFDF5;
  padding: 36rpx 32rpx 28rpx;
}

.hero-shop {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: var(--tap-min);
  margin-bottom: var(--space-md);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.16);
}

.hero-shop-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-title);
  word-break: break-word;
}

.hero-shop-go {
  flex-shrink: 0;
  margin-left: var(--gap);
  font-size: var(--fs-label);
  opacity: 0.78;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-kicker {
  font-size: var(--fs-caption);
  opacity: 0.78;
}

.hero-title {
  margin-top: 8rpx;
  font-size: var(--fs-display);
  font-weight: 700;
}

.hero-profit {
  text-align: right;
}

.hero-profit-num {
  margin-top: 8rpx;
  font-size: var(--fs-display);
  font-weight: 700;
}

.hero .stat-grid {
  margin-top: var(--space-xl);
  padding-top: var(--space-lg);
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}

.hero-press {
  opacity: 0.72;
}

.hero .stat-num {
  margin-bottom: 6rpx;
}

.stat .muted,
.hero-profit .muted {
  color: rgba(236, 253, 245, 0.72);
}

.stat-alert .stat-num {
  color: #FECACA;
}

.debt-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.debt-banner-num {
  margin-top: 8rpx;
  font-size: var(--fs-display);
  font-weight: 700;
  color: #C2410C;
}

.seed-btn {
  margin-top: 28rpx;
}

.btn-ghost {
  margin-top: 16rpx;
}

.empty-card,
.quiet {
  text-align: center;
  color: #64748B;
}

.list-card {
  padding: 8rpx 28rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}

.list-item:last-child {
  border-bottom: none;
}

.item-name {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.item-right {
  text-align: right;
}

.amount {
  margin-top: 8rpx;
  font-weight: 600;
}

.link {
  color: #0F766E;
  font-size: var(--fs-label);
}
