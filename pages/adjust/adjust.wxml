<view class="page">
  <view class="card">
    <field label="商品" mode="readonly" value="{{productName}}" />
    <field label="当前件数" mode="readonly" value="{{stockText}}" />
    <view class="muted tip">只改这一个格子的件数，不是整单盘点。</view>
    <view class="muted tip">{{hintText}}</view>
    <view class="muted tip" wx:if="{{blankProcess}}">待加工和现货要分开调，各改各的格。</view>

    <view class="spec-block" wx:if="{{hasSpecs}}">
      <field label="调整哪一格" dense>
        <view class="chips">
          <view
            class="chip {{item.on ? 'on' : ''}}"
            wx:for="{{cellOptions}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="pickCell"
          >{{item.specText}} {{item.stock}}</view>
        </view>
      </field>
    </view>

    <field label="方向">
      <view class="seg">
        <view class="seg-item {{direction === 'in' ? 'on' : ''}}" data-direction="in" bindtap="setDirection">入库</view>
        <view class="seg-item {{direction === 'out' ? 'on' : ''}}" data-direction="out" bindtap="setDirection">出库</view>
      </view>
    </field>

    <field label="原因">
      <view class="chips">
        <view
          class="chip {{item.on ? 'on' : ''}}"
          wx:for="{{reasonOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="pickReason"
        >{{item.label}}</view>
      </view>
    </field>

    <field label="数量">
      <input class="field-input" type="digit" data-field="qty" value="{{qty}}" bindinput="onField" placeholder="0" />
    </field>
    <field label="备注" last>
      <input class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="{{remarkPlaceholder}}" />
    </field>
  </view>

  <button class="btn-primary save-btn" bindtap="submit">确认调整</button>
</view>
