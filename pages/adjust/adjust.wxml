<view class="page">
  <view class="card">
    <view class="field">
      <view class="field-label">商品</view>
      <view class="field-input readonly js-adjust-product">{{productName}}</view>
    </view>
    <view class="field">
      <view class="field-label">当前件数</view>
      <view class="field-input readonly js-adjust-stock">{{stockText}}</view>
    </view>
    <view class="muted tip">只改这一个格子的件数，不是整单盘点。</view>
    <view class="muted tip">{{hintText}}</view>
    <view class="muted tip" wx:if="{{blankProcess}}">待加工和现货要分开调，各改各的格。</view>

    <view class="spec-block" wx:if="{{hasSpecs}}">
      <view class="field">
        <view class="field-label">调整哪一格</view>
        <view class="chips">
          <view
            class="chip {{item.on ? 'on' : ''}}"
            wx:for="{{cellOptions}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="pickCell"
          >{{item.specText}} {{item.stock}}</view>
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">方向</view>
      <view class="seg">
        <view class="seg-item {{direction === 'in' ? 'on' : ''}}" data-direction="in" bindtap="setDirection">入库</view>
        <view class="seg-item js-adjust-out {{direction === 'out' ? 'on' : ''}}" data-direction="out" bindtap="setDirection">出库</view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">原因</view>
      <view class="chips">
        <view
          class="chip {{item.on ? 'on' : ''}}"
          wx:for="{{reasonOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="pickReason"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">数量</view>
      <input class="field-input js-adjust-qty" type="digit" data-field="qty" value="{{qty}}" bindinput="onField" placeholder="0" />
    </view>
    <view class="field last">
      <view class="field-label">备注</view>
      <input class="field-input" data-field="remark" value="{{remark}}" bindinput="onField" placeholder="{{remarkPlaceholder}}" />
    </view>
  </view>

  <button class="btn-primary save-btn js-adjust-submit" bindtap="submit">确认调整</button>
</view>
