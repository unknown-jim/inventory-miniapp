.openid {
  margin: 16rpx 0;
  padding: 20rpx 24rpx;
  background: var(--c-surface);
  border-radius: var(--radius-md);
  word-break: break-all;
  font-size: var(--fs-label);
}

.copy-btn {
  margin-top: 12rpx;
}

.card + .card {
  margin-top: var(--space-md);
}

.list-card {
  padding: 8rpx 28rpx;
}

/* 列表行壳归 cell 组件；fold-head 是折叠头不是列表行，规则保留 */
.fold-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: var(--tap-min);
  padding: 24rpx 0;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: var(--fs-title);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.fold-head > .item-name {
  margin-bottom: 0;
}

.cell-go {
  flex-shrink: 0;
  margin-left: var(--gap);
  color: var(--c-muted);
  font-size: var(--fs-label);
}

.fold-body {
  padding-top: var(--space-md);
  border-top: 1rpx solid var(--c-line);
}

.seed-btn {
  margin-top: var(--space-lg);
}

.js-restore {
  margin-top: var(--space-md);
}

.restore-copy {
  margin-top: var(--space-lg);
}
