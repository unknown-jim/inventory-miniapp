<view class="page">
  <page-loading wx:if="{{pageLoading}}" />

  <!-- 稿 state/error 3:759（可重试：标题 + 一句话 + 一枚 primary）与
       state/error/blocking（不可重试）4:1041。标题和正文由 store.readyOrFailure()
       给，**不在这里写死**：「被移出店铺」和「网络断了」不是同一句话，
       而这一支两种都要落。 -->
  <view wx:elif="{{loadErrorText}}" class="card empty js-load-error">
    <view class="empty-title js-load-error-title">{{loadErrorTitle}}</view>
    <view class="muted js-load-error-text">{{loadErrorText}}</view>
    <view wx:if="{{loadErrorRetry}}" class="empty-actions">
      <button class="btn-primary js-load-error-retry" bindtap="reload">重试</button>
    </view>
  </view>
  <block wx:else>
  <view class="card main-card">
    <view class="thumb" bindtap="previewThumb">
      <image class="thumb-img" wx:if="{{image && !imageFailed}}" src="{{image}}" mode="aspectFill" binderror="onThumbError" />
      <view class="thumb-empty" wx:else>
        <text class="thumb-text">{{thumbText}}</text>
      </view>
    </view>
    <view class="main-col">
      <view class="name js-detail-name">{{name}}</view>
      <view class="price js-detail-price">¥{{priceText}}</view>
      <view wx:if="{{metaText}}" class="meta js-detail-meta">{{metaText}}</view>
    </view>
  </view>

  <view class="card stock-card">
    <view class="stock-title">库存全景</view>
    <view wx:if="{{hasSpecs}}" class="gate-row" bindtap="goAdjust">
      <text class="gate-hint">点规格改件数 · 换规格 / 盘点</text>
      <view class="gate-chevron"></view>
    </view>
    <view class="stock-cell js-detail-cell" wx:for="{{stockRows}}" wx:key="id" bindtap="goAdjust">
      <view wx:if="{{item.blank}}" class="blank-dot-wrap">
        <view class="blank-dot"></view>
      </view>
      <text class="cell-label js-detail-cell-label {{item.blank ? 'cell-label-blank' : ''}}">{{item.label}}</text>
      <text class="cell-qty js-detail-cell-qty {{item.blank ? 'cell-qty-blank' : ''}}">{{item.qtyText}}</text>
      <view class="cell-chevron"></view>
    </view>
  </view>

  <view class="actions">
    <button class="btn-primary js-detail-sale" bindtap="goSale">去销售</button>
    <view class="action-strip">
      <button class="btn-ghost js-detail-purchase" bindtap="goPurchase">去进货</button>
      <button class="btn-ghost js-detail-reprice" bindtap="goPrice">调价</button>
      <button class="btn-ghost js-detail-edit" bindtap="goEditProduct">编辑商品</button>
    </view>
  </view>
  </block>
</view>
