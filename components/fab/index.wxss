.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  padding: 0 28rpx;
  height: var(--tap-md);
  line-height: var(--tap-md);
  font-size: var(--fs-title);
  background: var(--c-primary);
  color: var(--c-inverse);
  border-radius: var(--radius-round);
  font-weight: 600;
  box-shadow: var(--shadow-raised);
}

.fab--lift {
  bottom: calc(48rpx + var(--safe-bottom));
}
