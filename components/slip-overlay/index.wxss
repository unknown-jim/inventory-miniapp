.slip-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  z-index: 1000;
}

.slip {
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
}

.slip-kicker {
  color: #0F766E;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.slip-title {
  margin: 8rpx 0 20rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.slip-shop {
  margin: 8rpx 0 0;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
}

.slip-shop + .slip-title {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.slip-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed #E2E8F0;
  color: #64748B;
  font-size: 22rpx;
}

.slip-party {
  margin-bottom: 8rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx dashed #E2E8F0;
}

.slip-lines {
  padding: 8rpx 0 12rpx;
  border-bottom: 2rpx dashed #E2E8F0;
}

.slip-line {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 14rpx 0;
}

.slip-line-main {
  flex: 1;
}

.slip-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 14rpx 0;
}

.slip-val {
  flex: 1;
  text-align: right;
  font-weight: 600;
}

.slip-total {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #E2E8F0;
}

.slip-total-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #134E4A;
}

.slip-debt-box {
  margin-top: 8rpx;
  padding-top: 8rpx;
}

.slip-debt {
  margin-top: 4rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #E2E8F0;
}

.slip-debt-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F766E;
}

.slip-debt-num.on {
  color: #C2410C;
}

/* 稿 export-style 22:5：label（12px muted）→ 两枚 chip 横排 → hint（12px muted）。
   这是店主点的操作控件，不属于单据版式，所以照常用操作界面那套变量（--fs-caption 一档）。
   docs/ui-scale.md「不要做」那条豁免管的是单据版式（本文件里模仿纸单排布的那些部分）
   和画布导出字号，操作控件是它写明的例外——判据是版式性质，不是长在哪个文件里。
   chip 本体直接复用 app.wxss 的 .chip / .chip.on，这里只补容器排布。 */
.export-style {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-top: 20rpx;
}

.export-style-label,
.export-style-hint {
  color: var(--color-text-muted);
  font-size: var(--fs-caption);
}

.export-style-chips {
  display: flex;
  gap: var(--space-md);
}

.slip-btn {
  margin-top: 0;
}

.slip-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.slip-actions .slip-btn {
  flex: 1;
}
