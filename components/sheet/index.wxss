.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--c-mask);
  display: flex;
  align-items: flex-end;
  z-index: var(--z-overlay);
}

.sheet {
  width: 100%;
  background: var(--c-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 28rpx 24rpx 12rpx;
  position: relative;
  z-index: var(--z-sheet);
}
