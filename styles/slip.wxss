.slip-mask {
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  z-index: 1000;
}

.slip {
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
}

.slip-kicker {
  color: #0F766E;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.slip-title {
  margin: 8rpx 0 20rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.slip-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed #E2E8F0;
  color: #64748B;
  font-size: 22rpx;
}

.slip-party {
  margin-bottom: 8rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx dashed #E2E8F0;
}

.slip-lines {
  padding: 8rpx 0 12rpx;
  border-bottom: 2rpx dashed #E2E8F0;
}

.slip-line {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 14rpx 0;
}

.slip-line-main {
  flex: 1;
}

.slip-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 14rpx 0;
}

.slip-val {
  flex: 1;
  text-align: right;
  font-weight: 600;
}

.slip-total {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #E2E8F0;
}

.slip-total-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #134E4A;
}

.slip-debt-box {
  margin-top: 8rpx;
  padding-top: 8rpx;
}

.slip-debt {
  margin-top: 4rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #E2E8F0;
}

.slip-debt-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F766E;
}

.slip-debt-num.on {
  color: #C2410C;
}

.slip-btn {
  margin-top: 0;
}

.slip-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.slip-actions .slip-btn {
  flex: 1;
}

.slip-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 750px;
  height: 3000px;
  pointer-events: none;
  opacity: 0;
}
